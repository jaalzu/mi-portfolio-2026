---
const { title, titleKey = null, icon = null, noControls = false, noPadding = false, color, colorTitle = false } = Astro.props;
---

<div class="glass-window" style={color ? `--accent: ${color};` : ''}>
  <div class="glass-titlebar">
    <span class="glass-title" data-i18n={titleKey || undefined}>{title}</span>
    {!noControls && (
      <div class="glass-controls">
        <button class="glass-btn min" aria-label="Minimize"><span>&#8211;</span></button>
        <button class="glass-btn max" aria-label="Maximize"><span>&#9633;</span></button>
        <button class="glass-btn close" aria-label="Close"><span>&#10005;</span></button>
      </div>
    )}
  </div>

  <div class={noPadding ? 'glass-body' : 'glass-body has-space'}>
    <slot />
  </div>

</div>

<style>
  .glass-window {
    --accent: rgba(120, 170, 255, 0.55);
    position: relative;
    border-radius: 10px;
    overflow: hidden;
    background: rgba(255, 255, 255, 0.030);
    backdrop-filter: blur(18px) saturate(140%);
    -webkit-backdrop-filter: blur(18px) saturate(140%);
    border: 1px solid rgba(255, 255, 255, 0.16);
    box-shadow:
      0 8px 24px rgba(0, 0, 0, 0.35),
      inset 0 1px 0 rgba(255, 255, 255, 0.18),
      inset 0 0 0 1px rgba(255, 255, 255, 0.04);
  }

  .glass-titlebar {
    position: relative;
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 5px 12px;
    background: linear-gradient(180deg, var(--accent) 0%, rgba(255, 255, 255, 0.05) 100%);
    border-bottom: 1px solid rgba(255, 255, 255, 0.096);
    cursor: move;
    -webkit-backdrop-filter: blur(6px);
    backdrop-filter: blur(6px);
  }



  .glass-title {
    font-size: 0.750rem;
  }

  .glass-controls {
  opacity: 0;
  }


  .glass-body {
    background: rgba(255, 255, 255, 0.030);
    box-sizing: border-box;
  }

  .glass-body.has-space {
    padding: 10px 12px;
  }
</style>