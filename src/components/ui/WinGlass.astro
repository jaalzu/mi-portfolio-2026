---
const { title, noControls = false, noPadding = false, color } = Astro.props;

---

<div class="background">
  <div class="window glass active" style={color ? `--w7-w-bg: ${color}` : ''}>
    <div class="title-bar">
      <div class="title-bar-text">{title}</div>
      {!noControls && (
        <div class="title-bar-controls">
          <button aria-label="Minimize"></button>
          <button aria-label="Maximize"></button>
          <button aria-label="Close"></button>
        </div>
      )}
    </div>
    <div class={noPadding ? "window-body" : "window-body has-space"}>
      <slot />
    </div>
    <slot name="status-bar" />
  </div>
</div>
<style>
.window-body {
  /* background: transparent !important; */
  background: rgba(255, 121, 3, 0.042) !important;
}

.window.glass {
  --w7-w-bg: rgba(255, 255, 255, 0) !important;
}
</style>