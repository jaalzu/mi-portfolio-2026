---
const { title, titleKey = null, icon = null, noControls = false, noPadding = false, color } = Astro.props;
---

<!-- WIN7 -->
<div class="win7-window background">
  <div
    class="window glass active"
    style={color ? `--w7-w-bg: ${color}; background: ${color};` : ''}
  >
    <div class="title-bar">
      <div class="title-bar-text" data-i18n={titleKey || undefined}>{title}</div>
      {!noControls && (
        <div class="title-bar-controls">
          <button aria-label="Minimize"></button>
          <button aria-label="Maximize"></button>
          <button aria-label="Close"></button>
        </div>
      )}
    </div>
    <div class={noPadding ? 'window-body' : 'window-body has-space'}>
      <slot />
    </div>
    <slot name="status-bar" />
    <slot name="footer" />
  </div>
</div>

<!-- XP -->
<div class="xp-window">
  <div class="window active">
    <div class="title-bar">
      <div class="title-bar-left">
        {icon && <img src={icon} alt="" class="title-icon" />}
        <div class="title-bar-text" data-i18n={titleKey || undefined}>{title}</div>
      </div>
      {!noControls && (
        <div class="title-bar-controls">
          <button aria-label="Minimize"></button>
          <button aria-label="Maximize"></button>
          <button aria-label="Close"></button>
        </div>
      )}
    </div>
    <div class={noPadding ? 'window-body' : 'window-body has-space'}>
      <slot />
    </div>
    <slot name="status-bar" />
    <slot name="footer" />
  </div>
</div>


<style>
  .title-icon {
    width: 17px;
    height: 17px;
    flex-shrink: 0;
  }

.win7-window .window.glass.active::before,
.win7-window .window.glass::before {
  display: none !important;
}
.win7-window .window.glass {
  backdrop-filter: blur(15px) !important;
  background: rgba(255, 255, 255, 0.037) !important;
}

 .xp-window .title-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.xp-window .title-bar-left {
  display: flex;
  align-items: center;
  gap: 4px;
}

.window-body{
  background-color: rgba(255, 255, 255, 0.031) !important;
}


  .title-bar {
    display: flex;
    align-items: center;
  }
</style>