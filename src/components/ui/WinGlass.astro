---
const { title, titleKey = null, icon = null, noControls = false, noPadding = false, color, colorTitle = false } = Astro.props;
---

<div class="glass-window" style={color ? `--accent: ${color};` : ''}>
  <div class="glass-titlebar">
    <span class="glass-title" data-i18n={titleKey || undefined}>{title}</span>
    {!noControls && (
      <div class="glass-controls">
        <button class="glass-btn min" aria-label="Minimize"><span>&#8211;</span></button>
        <button class="glass-btn max" aria-label="Maximize"><span>&#9633;</span></button>
        <button class="glass-btn close" aria-label="Close"><span>&#10005;</span></button>
      </div>
    )}
  </div>

  <div class={noPadding ? 'glass-body' : 'glass-body has-space'}>
    <slot />
  </div>

  <slot name="status-bar" />
  <slot name="footer" />
</div>

<style>
  .glass-window {
    --accent: rgba(120, 170, 255, 0.55);
    position: relative;
    border-radius: 10px;
    overflow: hidden;
    background: rgba(255, 255, 255, 0.045);
    backdrop-filter: blur(18px) saturate(140%);
    -webkit-backdrop-filter: blur(18px) saturate(140%);
    border: 1px solid rgba(255, 255, 255, 0.16);
    box-shadow:
      0 8px 24px rgba(0, 0, 0, 0.35),
      inset 0 1px 0 rgba(255, 255, 255, 0.18),
      inset 0 0 0 1px rgba(255, 255, 255, 0.04);
  }

  /* brillo sutil tipo aero en el borde superior */
  .glass-window::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    padding: 1px;
    background: linear-gradient(180deg, rgba(255,255,255,0.35), rgba(255,255,255,0) 40%);
    -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    pointer-events: none;
  }

  .glass-titlebar {
    position: relative;
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 6px 8px;
    background: linear-gradient(180deg, var(--accent) 0%, rgba(255, 255, 255, 0.05) 100%);
    border-bottom: 1px solid rgba(255, 255, 255, 0.12);
    cursor: move;
    -webkit-backdrop-filter: blur(6px);
    backdrop-filter: blur(6px);
  }

  .glass-icon {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
  }

  .glass-title {
    font-size: 0.750rem;
    font-weight: 600;
    color: #fff;
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.4);
    flex: 1;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .glass-controls {
    display: flex;
    gap: 4px;
    flex-shrink: 0;
  }

  .glass-btn {
    width: 22px;
    height: 20px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid rgba(255, 255, 255, 0.25);
    border-radius: 4px;
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.25), rgba(255, 255, 255, 0.05));
    color: #fff !important;
    font-size: 0.7rem;
    line-height: 1;
    cursor: pointer;
    transition: background 0.15s ease, border-color 0.15s ease;
  }

  .glass-btn:hover {
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.4), rgba(255, 255, 255, 0.1));
  }

  .glass-btn.close:hover {
    background: linear-gradient(180deg, rgba(255, 90, 80, 0.75), rgba(200, 40, 30, 0.55));
    border-color: rgba(255, 120, 110, 0.6);
  }

  .glass-body {
    background: rgba(255, 255, 255, 0.03);
    box-sizing: border-box;
  }

  .glass-body.has-space {
    padding: 9px 12px;
  }
</style>