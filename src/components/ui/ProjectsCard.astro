---
import '../../styles/glassRetro.css';
import Badge from './Badge.astro';
import ButtonPill from './ButtonPill.astro';
import ProjectModal from './ProjectModal.astro';

interface Props {
  title: string;
  description: string;
  projectUrl: string; 
  codeUrl: string;
  tech: string[];
  projectInfo: any;
}

const { title, description, projectUrl, codeUrl, tech, projectInfo } = Astro.props;
const uniqueId = `modal-${title.toLowerCase().replace(/\s+/g, '-')}`;
---

<div class="glass-base project-card">
  <div class="info">
    <h3>{title}</h3>
    <p>{description}</p>
    <div class="tech-list">
      {tech.map(t => <Badge text={t} />)}
    </div>
  </div>

  <div class="actions">
    <ButtonPill 
      projectUrl={projectUrl} 
      codeUrl={codeUrl} 
      modalId={uniqueId}
    />
  </div>
</div>

<ProjectModal id={uniqueId} title={title} projectInfo={projectInfo} />

<style>
.project-card {
  display: flex;
  flex-direction: column;
  gap: 1rem;
  border-radius: 28px;
  padding: .5rem 1rem;
}

.info {
  display: flex;
  flex-direction: column;
}

.info h3 {
  font-size: 1.3rem;
  color: var(--color-primary);
  margin-top: .7rem;
  margin-bottom: .2rem;
}

.info p {
  font-size: .940rem;
  margin-top: .3rem;
  line-height: 1.5;
}

.tech-list {
  display: flex;
  gap: .4rem;
  flex-wrap: wrap;
  margin-top: 0.1rem;
}

.actions {
  display: flex;
  align-items: center;
  padding: .5rem;
  justify-content: center;
}


/* ============================================
   small desktop
   ============================================ */


@media (max-width: 1522px) {
  .info h3{
    font-size: 1.5rem;
  }

  .info p{
    font-size: 1.1rem;
  }

  .actions{
    padding: .8rem;
  }
}


/* ============================================
   RESPONSIVE: MOBILE & TABLET
   ============================================ */
@media (max-width: 768px) {
  .info h3 {
    font-size: 1.4rem; 
  }

  .info p {
    font-size: 1rem; 
    line-height: 1.6;
  }

  .actions {
    padding: 1rem 0;
  }

  .actions :global(a), 
  .actions :global(button) {
    width: 100%; 
    font-size: 1rem;
  }
}

@media (max-width: 480px) {

  .project-card{
  padding: .5rem 1rem;

  }
  .info h3 {
    font-size: 1.3rem;
  }

  .info p{
    font-size: 1rem;
  }

  
}
</style>

