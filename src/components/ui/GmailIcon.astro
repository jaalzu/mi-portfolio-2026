---

const STRIPES = 8;
const VIEW_Y = 49.4;
const VIEW_H = 399.42;
const STRIPE_H = VIEW_H / STRIPES;
const stripes = Array.from({ length: STRIPES }, (_, i) => ({
  y: VIEW_Y + i * STRIPE_H - (i === 0 ? 0 : 1.5), // corre el inicio 1.5px hacia arriba (menos la primera)
  h: STRIPE_H + 3, // solape generoso arriba y abajo
}));
---

<svg class="gmail-icon" viewBox="0 49.4 512 399.42" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <clipPath id="gmail-stripes-clip">
   {stripes.map((s, i) => {
  const isLast = i === stripes.length - 1;
  const y = s.y;
  const h = isLast ? (49.4 + 399.42) - y + 2 : s.h; 
  return <rect class="gmail-stripe" data-i={i} x="0" y={y} width="0" height={h} />;
})}
    </clipPath>
  </defs>

  <!-- Versión base, blanca (currentColor), siempre visible -->
  <g fill="currentColor" fill-rule="evenodd">
    <g fill-rule="nonzero">
      <path d="M34.91 448.818h81.454V251L0 163.727V413.91c0 19.287 15.622 34.91 34.91 34.91z"/>
      <path d="M395.636 448.818h81.455c19.287 0 34.909-15.622 34.909-34.909V163.727L395.636 251z"/>
      <path d="M395.636 99.727V251L512 163.727v-46.545c0-43.142-49.25-67.782-83.782-41.891z"/>
    </g>
    <path d="M116.364 251V99.727L256 204.455 395.636 99.727V251L256 355.727z"/>
    <path fill-rule="nonzero" d="M0 117.182v46.545L116.364 251V99.727L83.782 75.291C49.25 49.4 0 74.04 0 117.18z"/>
  </g>

  <!-- Versión a color original, se revela por franjas via clip-path -->
  <g fill="none" fill-rule="evenodd" clip-path="url(#gmail-stripes-clip)">
    <g fill-rule="nonzero">
      <path fill="#4285f4" d="M34.91 448.818h81.454V251L0 163.727V413.91c0 19.287 15.622 34.91 34.91 34.91z"/>
      <path fill="#34a853" d="M395.636 448.818h81.455c19.287 0 34.909-15.622 34.909-34.909V163.727L395.636 251z"/>
      <path fill="#fbbc04" d="M395.636 99.727V251L512 163.727v-46.545c0-43.142-49.25-67.782-83.782-41.891z"/>
    </g>
    <path fill="#ea4335" d="M116.364 251V99.727L256 204.455 395.636 99.727V251L256 355.727z"/>
    <path fill="#c5221f" fill-rule="nonzero" d="M0 117.182v46.545L116.364 251V99.727L83.782 75.291C49.25 49.4 0 74.04 0 117.18z"/>
  </g>
</svg>

<style>
  .gmail-icon {
    width: 100%;
    height: 100%;
    display: block;
  }
</style>

<script>
  import { gsap } from "gsap";

  function initGmailIcon() {
    document.querySelectorAll(".gmail-btn").forEach((btn) => {
      const svg = btn.querySelector(".gmail-icon");
      if (!svg || svg.dataset.gmailInit) return;
      svg.dataset.gmailInit = "true";

      const stripes = Array.from(svg.querySelectorAll(".gmail-stripe"));
      let tl = null;

      btn.addEventListener("mouseenter", () => {
        tl && tl.kill();
        tl = gsap.timeline();
        tl.to(stripes, {
          attr: { width: 512 },
          duration: 0.15,
          ease: "power1.inOut",
          stagger: 0.025,
        });
      });

      btn.addEventListener("mouseleave", () => {
        tl && tl.kill();
        tl = gsap.timeline();
        tl.to([...stripes].reverse(), {
          attr: { width: 0 },
          duration: 0.15,
          ease: "power1.inOut",
          stagger: 0.025,
        });
      });
    });
  }

  document.addEventListener("astro:page-load", initGmailIcon);
  initGmailIcon();
</script>