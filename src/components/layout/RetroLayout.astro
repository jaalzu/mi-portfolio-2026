    ))}
  </div>
</div>
  </body>
</html>

<script is:inline>

  // ============================================
  // DRAG & DROP — mover ventanas por la title bar
  // ============================================
  let dragging = null;
  let offsetX = 0;
  let offsetY = 0;

  document.querySelectorAll('.win').forEach(win => {
    win.addEventListener('mousedown', (e) => {
      if (!e.target.closest('.title-bar')) return;
      dragging = win;
      offsetX = e.clientX - win.offsetLeft;
      offsetY = e.clientY - win.offsetTop;
      document.querySelectorAll('.win').forEach(w => w.style.zIndex = 1);
      win.style.zIndex = 10;
      e.preventDefault();
    });
  });

  document.addEventListener('mousemove', (e) => {
    if (!dragging) return;
    dragging.style.left = (e.clientX - offsetX) + 'px';
    dragging.style.top  = (e.clientY - offsetY) + 'px';
  });

  document.addEventListener('mouseup', () => { dragging = null; });


  // ============================================
  // TABS — cambiar paneles dentro de las ventanas
  // ============================================
document.querySelectorAll('[role="tablist"]').forEach(tablist => {
  const tabs = tablist.querySelectorAll('[role="tab"]');
  tabs.forEach(tab => {
    tab.addEventListener('click', () => {
      tabs.forEach(t => {
        t.setAttribute('aria-selected', 'false');
        document.getElementById(t.getAttribute('aria-controls'))?.setAttribute('hidden', '');
      });
      tab.setAttribute('aria-selected', 'true');
      document.getElementById(tab.getAttribute('aria-controls'))?.removeAttribute('hidden');
    });
  });
});


  // ============================================
  // SLIDER DE IMÁGENES — flechas prev/next por proyecto
  // ============================================
  document.querySelectorAll('[id$="-img"]').forEach(img => {
    const base = img.id.replace('-img', '');
    const images = img.getAttribute('data-images')?.split(',') ?? [];
    const counter = document.getElementById(`${base}-counter`);
    let current = 0;

    document.getElementById(`${base}-prev`)?.addEventListener('click', () => {
      current = (current - 1 + images.length) % images.length;
      img.src = images[current];
      if (counter) counter.textContent = `${current + 1} / ${images.length}`;
    });

    document.getElementById(`${base}-next`)?.addEventListener('click', () => {
      current = (current + 1) % images.length;
      img.src = images[current];
      if (counter) counter.textContent = `${current + 1} / ${images.length}`;
    });
  });

</script>

<script define:vars={{ bg1: bg1.src, bg2: bg2.src, bg3: bg3.src , bg4: bg4.src }}>
  // ============================================
  // SWITCHER DE FONDO — ciclar entre imágenes
  // ============================================
  const bgs = [bg1, bg2, bg3,bg4];
  const img = document.querySelector('.bg-container img');
  
  // Restaurar fondo guardado
  let currentBg = parseInt(localStorage.getItem('retro-bg') ?? '0');
  if (img) {
    img.src = bgs[currentBg];
    img.style.opacity = '0';
    img.onload = () => { img.style.opacity = '1'; };
  }

  document.getElementById('bg-switcher')?.addEventListener('click', () => {
    currentBg = (currentBg + 1) % bgs.length;
    if (img) {
      img.style.opacity = '0';
      img.src = bgs[currentBg];
      img.onload = () => { img.style.opacity = '1'; };
    }
    localStorage.setItem('retro-bg', currentBg.toString());
  });
</script>

<style is:global>
  * { box-sizing: border-box; }

  a, button, [role="button"] {
    cursor: url('/cursor/win7cur.cur'), pointer !important;
  }

  /* ============================================
     TOOLBAR — contenedor de botones fijos
  ============================================ */
  #retro-toolbar {
    position: fixed;
    bottom: 10px;
    left: 10px;
    right: 10px;
    z-index: 100;
    display: flex;
    justify-content: space-between;
    align-items: center;
    pointer-events: none;
  }

  #retro-toolbar > * {
    pointer-events: all;
  }

  #theme-switchers {
    display: flex;
    gap: 6px;
  }

  /* ============================================
     TEMA XP — estilos de botones
  ============================================ */
  [data-theme="xp"] a[role="button"] {
    display: inline-block;
    padding: 4px 12px;
    background: #ECE9D8;
    border: 2px solid;
    border-color: #fff #808080 #808080 #fff;
    cursor: pointer;
    font-size: 11px;
    text-decoration: none;
    color: #000;
  }

  [data-theme="xp"] a[role="button"]:active {
    border-color: #808080 #fff #fff #808080;
  }

  /* ============================================
     VARIABLES DE COLOR POR VENTANA
  ============================================ */
  :root {
    --win-about:    #2fff00;
    --win-projects: #d901ffe4;
    --win-tech:     #11ea40e1;
    --win-picture:     #0af038fb;
    --win-contact:  #22e20d66;
    --win-info:     #11fe00d8;
  }

  /* ============================================
     BASE
  ============================================ */
  body {
    margin: 0;
    padding: 0;
    min-height: 100vh;
    overflow: hidden;
  }

  .bg-container {
    position: fixed;
    inset: 0;
    z-index: -1;
    pointer-events: none;
  }

.bg-container img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center bottom;
  transition: opacity 0.3s;
}

  .desktop {
    position: relative;
    width: 100vw;
    height: 100vh;
  }

  a, button, [role="button"] {
  cursor: url('/cursor/cursor1.cur'), pointer !important;
}

* {
  cursor: url('/cursor/cursor1.cur'), default !important;
}

  /* ============================================
     VENTANAS ARRASTRABLES
  ============================================ */
  .win {
    position: absolute;
    cursor: default;
    z-index: 1;
  }

  .win .title-bar {
    cursor: move;
  }

[data-theme="xp"] .title-bar {
  padding-bottom: 3px;
  min-height: 26px;
  align-items: center;
}

  /* ============================================
     GLASS — desactivar en XP
  ============================================ */
  [data-theme="xp"] .background {
    display: contents;
  }

  [data-theme="xp"] .window.glass {
    background: none !important;
    --w7-w-bg: transparent !important;
  }

  [data-theme="xp"] .window[style] {
    background: unset !important;
    --w7-w-bg: unset !important;
  }

  [data-theme="xp"] .window-body {
    background: #ECE9D8 !important;
  }
</style>