    </main>
   <div id="retro-toolbar">
    <button id="bg-switcher">Cambiar Fondo</button>
  <div id="theme-switchers">
    {config.links.map((o) => (
      <a 
        href={o.href} 
        role="button"
        aria-disabled={o.href === Astro.url.pathname}
        style={o.href === Astro.url.pathname ? 'opacity: 0.5; pointer-events: none;' : ''}
