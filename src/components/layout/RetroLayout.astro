---
import RetroAboutMe from '../sections/RetroAboutMe.astro';
import RetroTechStack from '../sections/RetroTechStack.astro';
import ProjectCard from '../sections/project-card/ProjectCard.astro';
import RetroPicture from '../sections/RetroPicture.astro';
import Retrotooltip from '../ui/Retrotooltip.astro';
import { THEMES, type ThemeKey } from '../../lib/themes';
import ScrollBg from '../../components/ScrollBg.astro';

import DragScript from '../../scripts/drag.astro';
import SliderScript from '../../scripts/slider.astro';
import LangSwitcher from '../../scripts/langSwitcher.astro';

import '../../styles/win7.css';
import '../../styles/global.css';

// XP fue removido: ahora el único tema soportado es 'win7'.
const { theme = 'win7' } = Astro.props as { theme: ThemeKey };
const config = THEMES[theme];
---

<html lang="es" data-theme={config.dataTheme}>
  <head>
  <!-- Google Analytics -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-D213Q3J7LS"></script>

  <script is:inline>
    window.dataLayer = window.dataLayer || [];

    function gtag(...args) {
      window.dataLayer.push(args);
    }

    gtag('js', new Date());
    gtag('config', 'G-D213Q3J7LS');
  </script>


    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>Javier Alzú  {config.dataTheme.toUpperCase()}</title>


    <meta property="og:title" content="Javier Alzú · Frontend Developer" />
<meta property="og:description" content="Portfolio de Javier Alzú." />
<meta property="og:image" content="https://javalzu.vercel.app/og2.png" />
<meta property="og:url" content="https://javalzu.vercel.app/" />
<meta name="twitter:card" content="summary_large_image" />
<meta property="og:type" content="website" />
<meta name="twitter:image" content="https://javalzu.vercel.app/og2.png" />
<meta name="twitter:title" content="Javier Alzú · Frontend Developer" />
<link rel="icon" type="image/webp" sizes="16x16" href="/favicon16.webp" />
<link rel="icon" type="image/webp" sizes="32x32" href="/favicon32.webp" />
  </head>

  <body>
<!-- <ScrollBg /> -->

    <main class="desktop win7">
      <div class="win" id="win-picture" style="top: 10px; left:3vw">
        <RetroPicture xp={config.noGlass} />
      </div>

<Retrotooltip
  id="scroll-hint"
  text=      "¡Bienvenido a mi portfolio! Scrollea hacia abajo si quieres cambiar de estación.",

/>
      <div class="win" id="win-about" style="top: 250px; left: 3vw; width: 690px;">
        <RetroAboutMe xp={config.noGlass} />
      </div>


  <div class="win" id="win-p1" style="top: 15px; left: 63vw; width: 500px;">
  <ProjectCard
    xp={config.noGlass}
   title="TratoLibre"
    titleKey="p1WinTitle"
    projectTitle="TratoLibre"
    description="Marketplace de segunda mano para alquilar y vender objetos entre personas..."
    descKey="p1Desc"
    origin="Todos tenemos objetos que nos da vergüenza..."
    originKey="p1Origin"
    projectUrl="https://tratolibre.vercel.app"
    codeUrl="https://github.com/jaalzu/tratolibre"
    techKeys={{
      "Next.js 16": "tratolibreNextjs",
      "Client State": "tratolibreClientState",
      "Supabase": "tratolibreSupabase",
      "Arquitectura": "tratolibreArquitectura",
      "UI": "tratolibreUI",
        "Testing & Monitoring": "tratolibreValidation"
    }}
    images={["/projects/marketplace/1.webp","/projects/marketplace/2.webp","/projects/marketplace/3.webp","/projects/marketplace/4.webp","/projects/marketplace/5.webp"]}
    color="var(--win-projects)"
  />
</div>
<div class="win" id="win-p2" style="top: 270px; left: 63vw; width: 500px;">
  <ProjectCard
    xp={config.noGlass}
    title="PickYourColor"
    titleKey="p2WinTitle"
    projectTitle="PickYourColor"
    description="Visualizador interactivo de paletas de color con toolbar para modificar colores en tiempo real. Los cambios se aplican instantáneamente sobre componentes de UI y las paletas se pueden compartir por URL."
    descKey="p2Desc"
    origin="Nació para evitar el constante ir y venir entre el código y el navegador al crear y ajustar paletas de colores, permitiendo ver cambios en tiempo real y probar los colores directamente en una web profesional."
    originKey="p2Origin"
    projectUrl="https://pick-your-color-fi6u5v9bm-javier-alzus-projects.vercel.app/"
    codeUrl="https://github.com/jaalzu/PickYourColor"
    techKeys={{
      "Core": "colorCore",
      "UI & UX": "colorUI",
      "Color Engine": "colorEngine"
    }}
    images={["/projects/color/hero.webp","/projects/color/features.webp","/projects/color/comments.webp"]}
    color="var(--win-projects)"
  />
</div>

<div class="win" id="win-p3" style="top: 550px; left: 63vw; width: 500px;">
  <ProjectCard
    xp={config.noGlass}
    title="Courses WebApp"
    titleKey="p3WinTitle"
    projectTitle="Courses WebApp"
    description="Plataforma e-Learning con acceso por roles, gestión de cursos y lecciones, progreso de alumnos en tiempo real y foro de comunidad por curso."
    descKey="p3Desc"
    origin="El proyecto surgió cuando un mentor digital necesitaba una plataforma privada para ofrecer cursos a sus alumnos como parte de su programa de mentoría."
    originKey="p3Origin"
    projectUrl="https://courses-webapp-delta.vercel.app/login"
    codeUrl="https://github.com/jaalzu/courses-webapp"
    techKeys={{
      "Next.js 16": "coursesNextjs",
      "Client State": "coursesClientState",
      "Supabase": "coursesSupabase",
      "Arquitectura": "coursesArquitectura",
      "UI": "coursesUI",
      "Validation & Testing": "coursesValidation"
    }}
    images={["/projects/course/home.webp","/projects/course/form.webp","/projects/course/lesson.webp"]}
    color="var(--win-projects)"
  />
</div>
      <div class="win" id="win-tech" style="top: 560px; left: 3vw; width: 780px;">
        <RetroTechStack xp={config.noGlass} />
      </div>

      <div id="retro-toolbar">
  <div style="display: flex; gap: 6px;">

 <button id="lang-switcher" class="button-lang">EN</button>

  </div>
  </div>
    </main>



    <DragScript />
    <!-- <SliderScript /> -->
    <LangSwitcher />


<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    document.addEventListener('click', (e) => {
      if (e.target.id !== 'btn-about-portfolio') return;

      const modal = document.getElementById('win-about-portfolio-w7');
      if (modal) {
        modal.style.display = 'block';
        modal.style.zIndex = '50';
      }
    });

    const modal = document.getElementById('win-about-portfolio-w7');
    if (modal) {
      modal.querySelectorAll('[aria-label="Minimize"], [aria-label="Close"]')
        .forEach(b => b.addEventListener('click', () => {
          modal.style.display = 'none';
        }));
    }
  });
</script>

  </body>
</html>



<style>

  body {
  background: url('/bg/3.jpg') center / cover no-repeat fixed;
}

:root {
  --page-text-color: #fffffff7;
}
.button-lang{
  color: black !important;
}



@media (max-width: 640px) {
  #retro-toolbar {
    gap: 4px;
    padding: 4px;
  }

  #retro-toolbar button {
    font-size: 11px;
    padding: 2px 5px;
    min-width: unset;
  }

}

</style>