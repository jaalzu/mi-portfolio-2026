---
import WinGlass from '../ui/WinGlass.astro';
import AsciiPhoto from '../ui/AsciiPhoto.astro';
import GithubButton from '../ui/GithubButton.astro';
import LinkedinButton from '../ui/LinkedinButton.astro';
import GmailButton from '../ui/GmailButton.astro';
const { xp = false } = Astro.props;
---


<WinGlass
  title="Sobre mí"
  titleKey="winAbout"
  icon="retro/me-7.webp"
  color="var(--win-about)"
  noControls
  {xp}
>
  <div class="about-body">
    <div class="photo-column">
      <AsciiPhoto width="220px" height="200px" />
      <div class="contact-links">
        <GithubButton />
        <LinkedinButton />
        <GmailButton />
      </div>
    </div>

    <div class="about-content">
      <div class="about-text">
          <span class="slider-counter" id="about-counter"></span>

        <div class="slider" id="about-slider">
          <div class="slider-track" id="about-track">
            <div class="slide">
              <h1>
                <span class="rol" data-i18n="aboutRole"></span>
<span class="intro-line">
  Hola! soy <span class="name-binary" data-text="Javier">Javier</span>.
</span>
<br />
<span data-i18n="aboutText">Frontend Engineer que disfruta diseñar, mantener y escalar productos digitales. Encontré el balance perfecto entre resolver desafíos técnicos complejos y expresar mi creatividad a través del desarrollo de software.
La curiosidad y la disciplina fueron fundamentales en mi formación, impulsándome a afrontar  desafíos nuevos todos los días.
</span>
                <br />
                <span data-i18n="aboutText2">

                </span>
                <br />
                <span data-i18n="aboutText3"></span>
              </h1>
            </div>

            <div class="slide slide-2">
              <h1>
                <span>
            Desarrollo paginas y aplicaciones web utilizando principalmente JavaScript y su ecosistema moderno. 
            <br>
            Me gusta explorar nuevas herramientas y mantenerme al día con las tecnologías que impulsan la industria. 
            <br>
            En el último tiempo incorporé la inteligencia artificial a mi proceso de desarrollo para potenciar mis capacidades y mantener altos estándares de calidad en el código.
            
                </span>
              </h1>
            </div>

          <div class="slide slide-3">
  <h1>
   <span>
  Este portfolio nació como un tributo a Windows XP y Windows 7, que podés ver
  <a
    href="https://javalzuold.vercel.app/"
    target="_blank"
    rel="noopener noreferrer"
    class="old-portfolio-link"
  >
    aquí
  </a>.
  Con el tiempo evolucionó hasta convertirse en una interfaz completamente propia. Mi objetivo siempre fue diseñar una experiencia simple, rápida de recorrer y cuidada hasta el último detalle.
</span>

 <div class="portfolio-stack">

  <div class="stack-row">
    <span class="stack-label">Construido con</span>

    <img src="/icons/tech/astro-icon-dark.svg" alt="Astro" title="Astro" />
    <img src="/icons/tech/html5.svg" alt="HTML5" title="HTML5" />
    <img src="/icons/tech/css.svg" alt="CSS3" title="CSS3" />
 
  </div>

  <div class="stack-row">
    <span class="stack-label">Animado con</span>
   <img src="/icons/tech/javascript.svg" alt="JavaScript" title="JavaScript" />
    <img src="/icons/tech/gsap.svg" alt="GSAP" title="GSAP" />
  </div>

  <div class="stack-row">
    <span class="stack-label">Deployado en</span>

    <img src="/icons/tech/vercel_dark.svg" alt="Vercel" title="Vercel" />
  </div>

</div>
  </h1>
</div>
          </div>
        </div>

        <div class="slider-nav">
          <button class="nav-arrow prev" id="about-prev" aria-label="Anterior">
            &#8592;
          </button>


          <button class="nav-arrow next" id="about-next" aria-label="Siguiente">
            &#8594;
          </button>
        </div>
      </div>
    </div>
  </div>
</WinGlass>


<style>

  
  .about-body {
    display: flex;
    flex-direction: row;
    align-items: stretch;
    padding-bottom: 1rem;    
  }

  .photo-column {
    gap: 1rem;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .contact-links {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 12px;
  }

  .about-content {
    display: flex;
    flex-direction: column;
    justify-content: center;
    flex: 1;
    min-width: 0;
  }

  .about-text {
    position: relative;
  }

  .about-text h1 {
    font-size: 1.1rem;
    font-weight: 600;
    line-height: 1.4;
  }



.intro-line {
  display: block;
  font-size: 1.65em;
  font-weight: 700;
}

.name-binary {
  position: relative;
  display: inline-block;
  color: rgba(21, 255, 0, 0.9) !important;
  font-weight: 800;
  
  letter-spacing: 1px;
}



.portfolio-stack {
  margin-top: 24px;
  display: flex;
  flex-direction: column;
  gap: 14px;
}

.stack-row {
  display: flex;
  align-items: center;
  gap: 10px;
}

.stack-label {
  font-size: .75rem;
  color: rgba(255,255,255,.65);
  font-weight: 600;
  min-width: 95px;
}

.stack-row img {
  width: 18px;
  height: 18px;
  opacity: .9;
}


.name-binary::before,
.name-binary::after {
  content: attr(data-text);
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  overflow: hidden;
  background: transparent;
  pointer-events: none;
}

.name-binary::before {
  color: #ffffff;
  clip-path: inset(0 0 60% 0);
  animation: glitch-shift-1 2.6s infinite steps(2, end);
}

.name-binary::after {
  color: rgb(77, 255, 0);
  clip-path: inset(60% 0 0 0);
  animation: glitch-shift-2 2.6s infinite steps(2, end);
}

@keyframes glitch-shift-1 {
  0%, 92%, 100% { transform: translate(0, 0); opacity: 0; }
  93% { transform: translate(-3px, -1px); opacity: 0.9; }
  95% { transform: translate(3px, 1px); opacity: 0.9; }
  97% { transform: translate(-2px, 1px); opacity: 0.6; }
}

@keyframes glitch-shift-2 {
  0%, 92%, 100% { transform: translate(0, 0); opacity: 0; }
  93% { transform: translate(3px, 1px); opacity: 0.9; }
  95% { transform: translate(-3px, -1px); opacity: 0.9; }
  97% { transform: translate(2px, -1px); opacity: 0.6; }
}
  

  .about-text .old-portfolio-link {
    color: rgba(21, 255, 0, 0.832);
    text-decoration: none;
    font-weight: 600;
  }

  .slider {
    position: relative;
    overflow: hidden;
    min-height: 90px;
  }

  .slider-track {
    display: flex;
    width: 300%;
    transition: transform 0.45s cubic-bezier(0.65, 0, 0.35, 1);
    will-change: transform;
  }

  .slide {
    flex: 0 0 33.3333%;
    min-width: 0;
  }



.slider-nav {
  display: flex;
  justify-content: space-between;
  margin-top: 4px;
}

  .about-text .slider-nav .nav-arrow {
    background: none;
    border: none;
    cursor: pointer;
    font-size: 1.5rem;
    line-height: 1;
    padding: 2px 6px;
       color: #fff;

    opacity: 0;
    pointer-events: none;
    transform: translateX(0);
    transition: opacity 0.18s ease, color 0.15s ease;
  }

  .about-text .slider-nav .nav-arrow.prev {
    transform: translateX(-4px);
  }
 

  .about-text .slider-nav .nav-arrow.next {
    transform: translateX(4px);
  }
.about-text .slider-nav .nav-arrow.visible {
  opacity: 0.85;
  pointer-events: auto;
  transform: translateX(0);
  color: rgba(21, 255, 0, 0.75);
  transition: opacity 0.18s ease, transform 0.18s ease;
}

.about-text .slider-nav .nav-arrow.prev.visible:hover {
  opacity: 1;
  transform: translateX(-2px);
}

.about-text .slider-nav .nav-arrow.next.visible:hover {
  opacity: 1;
  transform: translateX(2px);
}
@keyframes shine-sweep {
  from {
    background-position: 100% 50%;
  }
  to {
    background-position: -100% 50%;
  }
}

 

  .slider-counter {
    position: absolute;
    top: -4px;
    right: 6px;
    font-size: 0.65rem;
    font-weight: 400;
    color: rgba(21, 255, 0, 0.887) !important;
    z-index: 1;
  }


  @media (max-width: 500px) {
    .about-body {
      flex-direction: column;
      align-items: center;
    }
    .about-text h1 {
      font-size: 1rem;
    }
  }
</style>

<script>
import { gsap } from 'gsap';


function initAboutSlider() {
  const track = document.getElementById('about-track');
  if (!track || track.dataset.initialized) return;
  track.dataset.initialized = 'true';

  const slides = Array.from(track.children);
  const prevBtn = document.getElementById('about-prev');
  const nextBtn = document.getElementById('about-next');
  const counterEl = document.getElementById('about-counter');
  let current = 0;

  // --- Brillo verde sobre la flecha "next": aparece una vez y
  // vuelve a aparecer cada ~3s mientras la flecha esté visible/activa.
 

  function updateArrows() {
    const nextVisible = current < slides.length - 1;
    prevBtn.classList.toggle('visible', current > 0);
    nextBtn.classList.toggle('visible', nextVisible);
    if (nextVisible) {
      startShine();
    } else {
      stopShine();
    }
  }

  function updateCounter(animate) {
    counterEl.textContent = `${current + 1}/${slides.length}`;
    if (!animate) return;
    counterEl.classList.remove('fade');
    void counterEl.offsetWidth;
    counterEl.classList.add('fade');
  }

  function render(animate = true) {
    track.style.transform = `translateX(-${current * (100 / slides.length)}%)`;
    updateCounter(animate);
    updateArrows();
  }

  prevBtn.addEventListener('click', () => {
    if (current > 0) {
      current--;
      render();
    }
  });

  nextBtn.addEventListener('click', () => {
    if (current < slides.length - 1) {
      current++;
      render();
    }
  });

  track.style.transition = 'none';
  updateArrows();
  render(false);
  requestAnimationFrame(() => {
    track.style.transition = '';
  });



}

document.addEventListener('astro:page-load', initAboutSlider);
initAboutSlider();
</script>