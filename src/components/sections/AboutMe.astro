---
// src/components/sections/AboutMe.astro
import Card from '../ui/Card.astro';
const originalText = "25 años · Chaco, Argentina";
const hoverText = "Gracias por pasarte. No te olvides de ver mis proyectos!";
---

<Card>
    <div class="about-me">
        <h2 class="name">Hola! Soy Javier A.</h2>
        <p class="subtitle">
            <span 
              id="decrypt-text" 
              class="decrypt-text"
              data-original={originalText}
              data-hover={hoverText}
            >
              <span class="text-content">{originalText}</span>
              <img src="/ar.svg" alt="Argentina flag" class="flag" />
            </span>
        </p>
        
        <h1 class="main-title">
            Desarrollador Frontend, enfocado en transformar requisitos complejos en experiencias de usuario destacadas. 
            Abordando cada proyecto con entusiasmo y trabajo duro.
        </h1>
        <br />
        <h2 class="commitment">Siempre comprometido a colaborar, aprender y mejorar cada día, con una gran atención al detalle y buenas prácticas.</h2>
    </div>
</Card>


<script is:inline>
  (function() {
    const el = document.getElementById('decrypt-text');
    if (!el) return;

    const textSpan = el.querySelector('.text-content');
    const flag = el.querySelector('.flag');
    const chars = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789!@#$%^&*";
    let interval = null;

    const animate = (targetText, isHovering) => {
        let iteration = 0;
        clearInterval(interval);
        
        if (flag) {
            flag.style.opacity = isHovering ? "0" : "1";
            flag.style.display = isHovering ? "none" : "inline-block";
        }

        interval = setInterval(() => {
            if (textSpan) {
                textSpan.innerText = targetText.split("")
                    .map((char, index) => {
                        if(index < iteration) return targetText[index];
                        return chars[Math.floor(Math.random() * chars.length)];
                    })
                    .join("");
            }
            
            if(iteration >= targetText.length) clearInterval(interval);
            iteration += 1;
        }, 18);
    };

    el.addEventListener('mouseenter', () => animate(el.dataset.hover, true));
    el.addEventListener('mouseleave', () => animate(el.dataset.original, false));
  })();
</script>

<style>

    /* Agrega esto a tus estilos existentes */
    .decrypt-text {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        cursor: pointer; /* Astro usará tu cursor personalizado del body */
    }

    .flag {
        width: 18px;
        height: auto;
        transition: opacity 0.3s ease;
    }


    .about-me {
        padding: 0rem;
        padding-inline: 1.5rem;
    }

    .name {
        font-size: 1.623rem; 
        margin-bottom: 0;
        font-weight: 700;
    }

    .subtitle {
        font-size: .930rem; 
        margin-top: .150rem;
        margin-bottom: 1.1rem;
        color: var(--color-primary);
        font-weight: 700;
    }

    .main-title {
        font-size: 1.930rem;
        line-height: 1.3;
        margin-bottom: 0;
        margin-top: 0;
        display: inline-block;
        width: 100%;
    }

    .highlight {
        color: var(--color-primary);
    }

    .word-rotate-wrapper {
        display: inline-block;
        margin: 0 4px;
        min-width: 90px;
        text-align: center;
        vertical-align: top;
    }

    .commitment {
        margin-bottom: 1.5rem;
        line-height: 1.3;

        font-size: 1.2rem;
        color: rgba(240, 248, 255, 0.927);
}


 /* ============================================
    small desktop (1522px)
   ============================================ */

@media (max-width: 1522px) {

    .about-me{
        padding-block: .5rem;

    }


    .name{
        font-size: 1.750rem;
    }

    .subtitle{
        font-size: .980rem;
    }

    .main-title{
        font-size: 2.2rem;
    }


}




@media (max-width: 1024px) {
    .about-me {
        padding-bottom: 1rem;
    }
    .name {
        margin-top: 1rem;
    }
    
    .commitment {
        font-size: 1.2rem;
        line-height: 1.5;
    }
}

@media (max-width: 768px) {
.about-me {
        padding-bottom: 1rem;
    }

    .name{
        margin-top: 1rem;
        font-size: 1.8rem;
    }
     .main-title {
        font-size: 1.7rem;
    }
    .commitment {
        font-size: 1.2rem;
    }
}

@media (max-width: 480px) {
    .about-me {
        padding-inline: 1.3rem;
        padding-bottom: .5rem;
    }
    .name {
        font-size: 1.4rem;
    }
    
    .subtitle {
        font-size: .9rem;
    }
    .main-title {
        font-size: 1.6rem;
    }
    .commitment {
        font-size: 1.1rem;

    }
}

</style>