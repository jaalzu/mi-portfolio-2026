---
import Card from '../ui/Card.astro';
import DecryptedText from '@/components/ui/DecryptedText.tsx';
import WordRotate from "@/components/ui/WordRotate.tsx";
---

<Card>
    <div class="about-me">
        <h2 class="name">Hola! Soy Javier A.</h2>
        <p class="subtitle">
            <DecryptedText 
                client:load
                originalText="25 años ·  Chaco, Argentina"
                hoverText="Gracias por pasarte. No te olvides de ver mis proyectos!"
                className=""
            />
        </p>
        
   <h1 class="main-title">
   Desarrollador Frontend, enfocado en transformar requisitos complejos en experiencias de usuario destacadas,
  creadas con código
  <span class="word-rotate-wrapper">
    <WordRotate
      client:load
      words={["limpio.", "seguro.", "optimizado.", "escalable."]}
      delay={1600}
    />
  </span>
</h1>
        <br />
        <h2 class="commitment">Siempre comprometido a colaborar, aprender y mejorar cada día, con una gran atención al detalle y buenas prácticas.</h2>
    </div>
</Card>

<style>
    .about-me {
        padding: 0rem;
        padding-inline: 2rem;
    }

    .name {
        font-size: 1.623rem; 
        margin-bottom: 0;
        font-weight: 700;
    }

    .subtitle {
        font-size: .930rem; 
        margin-top: .150rem;
        margin-bottom: 1.1rem;
        color: var(--color-primary);
        font-weight: 700;
    }

    .main-title {
        font-size: 2rem;
        line-height: 1.3;
        margin-bottom: 0;
        margin-top: 0;
        display: inline-block;
        width: 100%;
    }

    .highlight {
        color: var(--color-primary);
    }

    .word-rotate-wrapper {
        display: inline-block;
        margin: 0 4px;
        min-width: 90px;
        text-align: center;
        vertical-align: top;
    }

    .commitment {
        margin-bottom: 1.5rem;
        line-height: 1.3;

        font-size: 1.5rem;
        color: rgba(240, 248, 255, 0.927);
}

@media (max-width: 1024px) {
    .about-me {
        padding-bottom: 1rem;
    }
    .name {
        margin-top: 1rem;
    }
    
    .commitment {
        font-size: 1.2rem;
        line-height: 1.5;
    }
}

@media (max-width: 768px) {
.about-me {
        padding-bottom: 1rem;
    }

    .name{
        margin-top: 1rem;
        font-size: 1.8rem;
    }
     .main-title {
        font-size: 2rem;
    }
    .commitment {
        font-size: 1.2rem;
    }
}

@media (max-width: 480px) {
    .about-me {
        padding-inline: 1.3rem;
        padding-bottom: .5rem;
    }
    .name {
        font-size: 1.4rem;
    }
    
    .subtitle {
        
        font-size: .9rem;
    }
    .main-title {
        font-size: 1.7rem;
    }
    .commitment {
        font-size: 1.050rem;

    }
}

</style>