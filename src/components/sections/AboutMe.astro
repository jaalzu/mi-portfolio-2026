---
import WinGlass from '../ui/WinGlass.astro';
import AsciiPhoto from '../ui/AsciiPhoto.astro';
import GithubButton from '../ui/GithubButton.astro';
import LinkedinButton from '../ui/LinkedinButton.astro';
import GmailButton from '../ui/GmailButton.astro';
const { xp = false } = Astro.props;
---


<WinGlass
  title="Sobre mí"
  titleKey="winAbout"
  icon="retro/me-7.webp"
  color="var(--win-about)"
  noControls
  {xp}
>
  <div class="about-body">
    <div class="photo-column">
      <AsciiPhoto width="220px" height="200px" />
      <div class="contact-links">
        <GithubButton />
        <LinkedinButton />
        <GmailButton />
      </div>
    </div>

    <div class="about-content">
      <div class="about-text">
          <span class="slider-counter" id="about-counter"></span>

        <div class="slider" id="about-slider">
          <div class="slider-track" id="about-track">
            <div class="slide">
              <h1>
                <span class="rol" data-i18n="aboutRole"></span>
<span class="intro-line">
  Hola! soy <span class="name-binary" data-text="Javier">Javier</span>.
</span>
<br />
<span data-i18n="aboutText">Soy desarrollador de software y disfruto crear para el lado del cliente. Mi experiencia abarca todo el proceso de desarrollo de un producto, desde el diseño de interfaces hasta el desarrollo de aplicaciones web escalables, principalmente dentro del ecosistema moderno de 
  Javascript.</span>
                <br />
                <span data-i18n="aboutText2">

                </span>
                <br />
                <span data-i18n="aboutText3"></span>
              </h1>
            </div>

            <div class="slide">
              <h1>
                <span>La programación me permite combinar creatividad e ingeniería. Disfruto resolver desafíos técnicos y crear productos digitales intuitivos, seguros, mantenibles y pensados para perdurar. La curiosidad, el aprendizaje continuo y la atención al detalle son los pilares que guían mi forma de desarrollar.</span>
              </h1>
            </div>

            <div class="slide">
              <h1>
                <span>El portfolio esta construido sobre Astro con HTML,CSS y Javascript. 
                  <br>
                  Deployado en Vercel.
                  <br>
                  Utilice GSAP para las animaciones .
                  <br>
                  La foto del fondo la saque yo.
                  <br>
                  Buscaba diseñar algo rapido de leer , atractivo con pequeños pero poderosos detalles , comenzo como un tributo a windows xp y 7 , pero termine diseñando mi propia UI.
                  <br>
                  Puedes ver mi anterior portfolio 
                </span>
                <span>
                  <a
                    href="https://javalzuold.vercel.app/"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="old-portfolio-link"
                  > aquí</a>.
                </span>
              </h1>
            </div>
          </div>
        </div>

        <div class="slider-nav">
          <button class="nav-arrow prev" id="about-prev" aria-label="Anterior">
            &#8592;
          </button>


          <button class="nav-arrow next" id="about-next" aria-label="Siguiente">
            &#8594;
          </button>
        </div>
      </div>
    </div>
  </div>
</WinGlass>
<style>

  
  .about-body {
    display: flex;
    flex-direction: row;
    align-items: stretch;
    padding-bottom: 1rem;    
  }

  .photo-column {
    gap: 1rem;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .contact-links {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 12px;
  }

  .about-content {
    display: flex;
    flex-direction: column;
    justify-content: center;
    flex: 1;
    min-width: 0;
  }

  .about-text {
    position: relative;
  }

  .about-text h1 {
    font-size: 1.1rem;
    font-weight: 600;
    line-height: 1.4;
  }



.intro-line {
  display: block;
  font-size: 1.65em;
  font-weight: 700;
}

.name-binary {
  position: relative;
  display: inline-block;
  color: rgba(21, 255, 0, 0.9) !important;
  font-weight: 800;
  
  letter-spacing: 1px;
}

.name-binary::before,
.name-binary::after {
  content: attr(data-text);
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  overflow: hidden;
  background: transparent;
  pointer-events: none;
}

.name-binary::before {
  color: #ffffff;
  clip-path: inset(0 0 60% 0);
  animation: glitch-shift-1 2.6s infinite steps(2, end);
}

.name-binary::after {
  color: rgb(77, 255, 0);
  clip-path: inset(60% 0 0 0);
  animation: glitch-shift-2 2.6s infinite steps(2, end);
}

@keyframes glitch-shift-1 {
  0%, 92%, 100% { transform: translate(0, 0); opacity: 0; }
  93% { transform: translate(-3px, -1px); opacity: 0.9; }
  95% { transform: translate(3px, 1px); opacity: 0.9; }
  97% { transform: translate(-2px, 1px); opacity: 0.6; }
}

@keyframes glitch-shift-2 {
  0%, 92%, 100% { transform: translate(0, 0); opacity: 0; }
  93% { transform: translate(3px, 1px); opacity: 0.9; }
  95% { transform: translate(-3px, -1px); opacity: 0.9; }
  97% { transform: translate(2px, -1px); opacity: 0.6; }
}
  

  .about-text .old-portfolio-link {
    color: rgba(21, 255, 0, 0.832);
    text-decoration: none;
    font-weight: 600;
  }

  .slider {
    position: relative;
    overflow: hidden;
    min-height: 90px;
  }

  .slider-track {
    display: flex;
    width: 300%;
    transition: transform 0.45s cubic-bezier(0.65, 0, 0.35, 1);
    will-change: transform;
  }

  .slide {
    flex: 0 0 33.3333%;
    min-width: 0;
  }



.slider-nav {
  display: flex;
  justify-content: space-between;
  margin-top: 4px;
}

  .about-text .slider-nav .nav-arrow {
    background: none;
    border: none;
    cursor: pointer;
    font-size: 1.5rem;
    line-height: 1;
    padding: 2px 6px;
       color: #fff;

    opacity: 0;
    pointer-events: none;
    transform: translateX(0);
    transition: opacity 0.18s ease, color 0.15s ease;
  }

  .about-text .slider-nav .nav-arrow.prev {
    transform: translateX(-4px);
  }
 

  .about-text .slider-nav .nav-arrow.next {
    transform: translateX(4px);
  }
.about-text .slider-nav .nav-arrow.visible {
  opacity: 0.85;
  pointer-events: auto;
  transform: translateX(0);
  color: rgba(21, 255, 0, 0.75);
  transition: opacity 0.18s ease, transform 0.18s ease;
}

.about-text .slider-nav .nav-arrow.prev.visible:hover {
  opacity: 1;
  transform: translateX(-2px);
}

.about-text .slider-nav .nav-arrow.next.visible:hover {
  opacity: 1;
  transform: translateX(2px);
}
@keyframes shine-sweep {
  from {
    background-position: 100% 50%;
  }
  to {
    background-position: -100% 50%;
  }
}

 

  .slider-counter {
    position: absolute;
    top: -4px;
    right: 6px;
    font-size: 0.65rem;
    font-weight: 400;
    color: rgba(21, 255, 0, 0.887) !important;
    z-index: 1;
  }


  @media (max-width: 500px) {
    .about-body {
      flex-direction: column;
      align-items: center;
    }
    .about-text h1 {
      font-size: 1rem;
    }
  }
</style>

<script>
import { gsap } from 'gsap';


function initAboutSlider() {
  const track = document.getElementById('about-track');
  if (!track || track.dataset.initialized) return;
  track.dataset.initialized = 'true';

  const slides = Array.from(track.children);
  const prevBtn = document.getElementById('about-prev');
  const nextBtn = document.getElementById('about-next');
  const counterEl = document.getElementById('about-counter');
  let current = 0;

  // --- Brillo verde sobre la flecha "next": aparece una vez y
  // vuelve a aparecer cada ~3s mientras la flecha esté visible/activa.
 

  function updateArrows() {
    const nextVisible = current < slides.length - 1;
    prevBtn.classList.toggle('visible', current > 0);
    nextBtn.classList.toggle('visible', nextVisible);
    if (nextVisible) {
      startShine();
    } else {
      stopShine();
    }
  }

  function updateCounter(animate) {
    counterEl.textContent = `${current + 1}/${slides.length}`;
    if (!animate) return;
    counterEl.classList.remove('fade');
    void counterEl.offsetWidth;
    counterEl.classList.add('fade');
  }

  function render(animate = true) {
    track.style.transform = `translateX(-${current * (100 / slides.length)}%)`;
    updateCounter(animate);
    updateArrows();
  }

  prevBtn.addEventListener('click', () => {
    if (current > 0) {
      current--;
      render();
    }
  });

  nextBtn.addEventListener('click', () => {
    if (current < slides.length - 1) {
      current++;
      render();
    }
  });

  track.style.transition = 'none';
  updateArrows();
  render(false);
  requestAnimationFrame(() => {
    track.style.transition = '';
  });



}

document.addEventListener('astro:page-load', initAboutSlider);
initAboutSlider();
</script>