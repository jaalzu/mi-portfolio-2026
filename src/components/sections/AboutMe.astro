---
import WinGlass from '../ui/WinGlass.astro';
import AsciiPhoto from '../ui/AsciiPhoto.astro';
import GithubButton from '../ui/GithubButton.astro';
import LinkedinButton from '../ui/LinkedinButton.astro';
import GmailButton from '../ui/GmailButton.astro';

const { xp = false } = Astro.props;
---


<WinGlass
  title="Sobre mí"
  titleKey="winAbout"
  icon="retro/me-7.webp"
  color="var(--win-about)"
  noControls
  {xp}
>
  <div class="about-body">
    <div class="photo-column">
      <AsciiPhoto width="220px" height="200px" />
      <div class="contact-links">
        <GithubButton />
        <LinkedinButton />
        <GmailButton />
      </div>
    </div>

    <div class="about-content">
      <div class="about-text">
          <span class="slider-counter" id="about-counter"></span>

        <div class="slider" id="about-slider">
          <div class="slider-track" id="about-track">
            <div class="slide">
              <h1>
                <span class="rol" data-i18n="aboutRole"></span>
                <span data-i18n="aboutText"></span>
                <br />
                <span data-i18n="aboutText2"></span>
                <br />
                <span data-i18n="aboutText3"></span>
              </h1>
            </div>

            <div class="slide">
              <h1>
                <span>Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod tempor incididunt ut labore et dolore magna aliqua.</span>
              </h1>
            </div>

            <div class="slide">
              <h1>
                <span>El portfolio esta construido sobre Astro con HTML,CSS y Javascript. 
                  <br>
                  Deployado en Vercel.
                  <br>
                  Utilice GSAP para las animaciones .
                  <br>
                  La foto del fondo la saque yo.
                  <br>
                  Buscaba diseñar algo rapido de leer , atractivo con pequeños pero poderosos detalles , comenzo como un tributo a windows xp y 7 , pero termine diseñando mi propia UI.
                  <br>
                  Puedes ver mi anterior portfolio 
                </span>
                <span>
                  <a
                    href="https://javalzu-5dg4kxo9t-javier-alzus-projects.vercel.app/?lang=es"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="old-portfolio-link"
                  > aquí</a>.
                </span>
              </h1>
            </div>
          </div>
        </div>

        <div class="slider-nav">
          <button class="nav-arrow prev" id="about-prev" aria-label="Anterior">
            &#8592;
          </button>


          <button class="nav-arrow next" id="about-next" aria-label="Siguiente">
            &#8594;
          </button>
        </div>
      </div>
    </div>
  </div>
</WinGlass>
<style>

  
  .about-body {
    display: flex;
    flex-direction: row;
    align-items: stretch;
    padding-bottom: 1rem;    
  }

  .photo-column {
    gap: 1rem;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .contact-links {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 12px;
  }

  .about-content {
    display: flex;
    flex-direction: column;
    justify-content: center;
    flex: 1;
    min-width: 0;
  }

  .about-text {
    position: relative;
  }

  .about-text h1 {
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.4;
  }

  .about-text .old-portfolio-link {
    color: rgba(21, 255, 0, 0.832);
    text-decoration: none;
    font-weight: 600;
  }

  .slider {
    position: relative;
    overflow: hidden;
    min-height: 90px;
  }

  .slider-track {
    display: flex;
    width: 300%;
    transition: transform 0.45s cubic-bezier(0.65, 0, 0.35, 1);
    will-change: transform;
  }

  .slide {
    flex: 0 0 33.3333%;
    min-width: 0;
  }



.slider-nav {
  display: flex;
  justify-content: space-between;
  margin-top: 4px;
}

  .about-text .slider-nav .nav-arrow {
    background: none;
    border: none;
    cursor: pointer;
    font-size: 1.5rem;
    line-height: 1;
    padding: 2px 6px;
       color: #fff;

    opacity: 0;
    pointer-events: none;
    transform: translateX(0);
    transition: opacity 0.18s ease, color 0.15s ease;
  }

  .about-text .slider-nav .nav-arrow.prev {
    transform: translateX(-4px);
  }
 

  .about-text .slider-nav .nav-arrow.next {
    transform: translateX(4px);
  }
.about-text .slider-nav .nav-arrow.visible {
  opacity: 0.85;
  pointer-events: auto;
  transform: translateX(0);
  color: rgba(21, 255, 0, 0.75);
  transition: opacity 0.18s ease, transform 0.18s ease;
}

.about-text .slider-nav .nav-arrow.prev.visible:hover {
  opacity: 1;
  transform: translateX(-2px);
}

.about-text .slider-nav .nav-arrow.next.visible:hover {
  opacity: 1;
  transform: translateX(2px);
}
@keyframes shine-sweep {
  from {
    background-position: 100% 50%;
  }
  to {
    background-position: -100% 50%;
  }
}

 

  .slider-counter {
    position: absolute;
    top: -8px;
    right: 6px;
    font-size: 0.65rem;
    font-weight: 400;
    color: rgba(21, 255, 0, 0.887) !important;
    z-index: 1;
  }


  @media (max-width: 500px) {
    .about-body {
      flex-direction: column;
      align-items: center;
    }
    .about-text h1 {
      font-size: 1rem;
    }
  }
</style>

<script>
import { gsap } from 'gsap';

function initAboutSlider() {
  const track = document.getElementById('about-track');
  if (!track || track.dataset.initialized) return;
  track.dataset.initialized = 'true';

  const slides = Array.from(track.children);
  const prevBtn = document.getElementById('about-prev');
  const nextBtn = document.getElementById('about-next');
  const counterEl = document.getElementById('about-counter');
  let current = 0;

  // --- Brillo verde sobre la flecha "next": aparece una vez y
  // vuelve a aparecer cada ~3s mientras la flecha esté visible/activa.
  let shineTl = null;

  function startShine() {
    if (shineTl) return;
    shineTl = gsap.timeline({ repeat: -1, repeatDelay: 3 });
    shineTl
      .fromTo(
        nextBtn,
        { textShadow: '0 0 0px rgba(21,255,0,0)' },
        { textShadow: '0 0 10px rgba(21,255,0,0.9)', duration: 0.5, ease: 'power2.out' }
      )
      .to(nextBtn, { textShadow: '0 0 0px rgba(21,255,0,0)', duration: 0.6, ease: 'power2.in' });
  }

  function stopShine() {
    if (shineTl) {
      shineTl.kill();
      shineTl = null;
    }
    gsap.set(nextBtn, { textShadow: '0 0 0px rgba(21,255,0,0)' });
  }

  function updateArrows() {
    const nextVisible = current < slides.length - 1;
    prevBtn.classList.toggle('visible', current > 0);
    nextBtn.classList.toggle('visible', nextVisible);
    if (nextVisible) {
      startShine();
    } else {
      stopShine();
    }
  }

  function updateCounter(animate) {
    counterEl.textContent = `${current + 1}/${slides.length}`;
    if (!animate) return;
    counterEl.classList.remove('fade');
    void counterEl.offsetWidth;
    counterEl.classList.add('fade');
  }

  function render(animate = true) {
    track.style.transform = `translateX(-${current * (100 / slides.length)}%)`;
    updateCounter(animate);
    updateArrows();
  }

  prevBtn.addEventListener('click', () => {
    if (current > 0) {
      current--;
      render();
    }
  });

  nextBtn.addEventListener('click', () => {
    if (current < slides.length - 1) {
      current++;
      render();
    }
  });

  track.style.transition = 'none';
  updateArrows();
  render(false);
  requestAnimationFrame(() => {
    track.style.transition = '';
  });



}

document.addEventListener('astro:page-load', initAboutSlider);
initAboutSlider();
</script>