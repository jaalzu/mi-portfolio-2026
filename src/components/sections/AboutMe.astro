---
import WinGlass from '../ui/WinGlass.astro';
import AsciiPhoto from '../ui/AsciiPhoto.astro';
import GithubButton from '../ui/GithubButton.astro';
import LinkedinButton from '../ui/LinkedinButton.astro';
import GmailButton from '../ui/GmailButton.astro';
const { xp = false } = Astro.props;
---

<WinGlass
  titleKey="winAbout"
  icon="retro/me-7.webp"
  color="var(--win-about)"
  noControls
  noTitlebar
  {xp}
>
  <div class="about-body">
    <div class="photo-column">
      <AsciiPhoto width="220px" height="200px" />

      <div class="contact-links">
        <GithubButton />
        <LinkedinButton />
        <GmailButton />
      </div>
    </div>

    <div class="about-content">
      <div class="about-text">

        <div class="slider" id="about-slider">
          <div class="slider-track" id="about-track">

            <!-- Slide 1 -->
            <div class="slide">
              <h1>
                <span class="rol" data-i18n="aboutRole"></span>

                <span class="intro-line">
                  <span data-i18n="aboutGreeting"></span>
                  <span class="name-binary" data-text="Javier">Javier</span>.
                </span>

                <br />

                <span data-i18n="aboutText"></span>
              </h1>
            </div>

            <!-- Slide 2 -->
            <div class="slide slide-2">
              <h1>
                <span data-i18n="aboutWork"></span>
              </h1>
            </div>

            <!-- Slide 3 -->
            <div class="slide slide-3">
              <h1>
                <span>
                  <span data-i18n="aboutPortfolio"></span>

                  <a
                    href="https://javalzuold.vercel.app/"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="old-portfolio-link"
                    data-i18n="aboutPortfolioLink"
                    data-preview="/og2.webp"
                  ></a>.

                  <br />

                  <span data-i18n="aboutPortfolio2"></span>
                </span>

                <div class="portfolio-stack">

                  <div class="stack-group">
                    <span class="stack-label" data-i18n="stackFramework"></span>

                    <div class="stack-icons">
                      <img
                        src="/icons/tech/astro-icon-dark.svg"
                        alt="Astro"
                        title="Astro"
                        class="astro-icon"
                      />
                    </div>
                  </div>

                  <div class="stack-group">
                    <span class="stack-label" data-i18n="stackStyling"></span>

                    <div class="stack-icons">
                      <img
                        src="/icons/tech/css-dark.svg"
                        alt="CSS3"
                        title="CSS3"
                      />
                    </div>
                  </div>

                  <div class="stack-group">
                    <span class="stack-label" data-i18n="stackAnimations"></span>

                    <div class="stack-icons">
                      <img
                        src="/icons/tech/javascript-dark.svg"
                        alt="JavaScript"
                        title="JavaScript"
                      />
                      <img
                        src="/icons/tech/gsap.svg"
                        alt="GSAP"
                        title="GSAP"
                      />
                    </div>
                  </div>

                  <div class="stack-group">
                    <span class="stack-label" data-i18n="stackDeployment"></span>

                    <div class="stack-icons">
                      <img
                        src="/icons/tech/vercel_dark.svg"
                        alt="Vercel"
                        title="Vercel"
                      />
                    </div>
                  </div>

                </div>
              </h1>
            </div>

          </div>
        </div>

        <div class="slider-footer">
          <div class="slider-lines" id="about-lines">
            <span class="slider-line" data-index="0"></span>
            <span class="slider-line" data-index="1"></span>
            <span class="slider-line" data-index="2"></span>
          </div>
        </div>

      </div>
    </div>
  </div>
</WinGlass>


<style>

  .about-text h1 {
  white-space: pre-line;
}
  /* ============================================
     LAYOUT GENERAL (foto + contenido)
  ============================================ */
  .about-body {
    display: flex;
    flex-direction: row;
    align-items: stretch;
    padding-bottom: 1rem;
  }

  .photo-column {
    gap: 1rem;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .contact-links {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 12px;
  }

  .about-content {
    display: flex;
    flex-direction: column;
    justify-content: center;
    flex: 1;
    min-width: 0;
  }

 .about-text {
  position: relative;
  width: 100%;
  min-width: 0;
}

.slider {
  position: relative;
  overflow: hidden;
  width: 100%;
  min-width: 0;
}



.about-text h1 {
  font-size: 1.1rem;
  font-weight: 600;
  line-height: 1.4;
  width: 100%;
  overflow-wrap: break-word;
  word-break: break-word;
}
  /* ============================================
     INTRO / NOMBRE (efecto glitch)
  ============================================ */
.intro-line {
  display: block;
  font-size: 1.65em;
  font-weight: 700;
  overflow-wrap: break-word;
  word-break: break-word;
}

  .name-binary {
    position: relative;
    display: inline-block;
    color: var(--accent-90) !important;
    font-weight: 800;
    letter-spacing: 1px;
  }

  .name-binary::before,
  .name-binary::after {
    content: attr(data-text);
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    overflow: hidden;
    background: transparent;
    pointer-events: none;
  }

  .name-binary::before {
    color: #ffffff;
    clip-path: inset(0 0 60% 0);
    animation: glitch-shift-1 2.6s infinite steps(2, end);
  }

  .name-binary::after {
    color: rgb(var(--accent-rgb-alt));
    clip-path: inset(60% 0 0 0);
    animation: glitch-shift-2 2.6s infinite steps(2, end);
  }

  @keyframes glitch-shift-1 {
    0%, 92%, 100% { transform: translate(0, 0); opacity: 0; }
    93% { transform: translate(-3px, -1px); opacity: 0.9; }
    95% { transform: translate(3px, 1px); opacity: 0.9; }
    97% { transform: translate(-2px, 1px); opacity: 0.6; }
  }

  @keyframes glitch-shift-2 {
    0%, 92%, 100% { transform: translate(0, 0); opacity: 0; }
    93% { transform: translate(3px, 1px); opacity: 0.9; }
    95% { transform: translate(-3px, -1px); opacity: 0.9; }
    97% { transform: translate(2px, -1px); opacity: 0.6; }
  }

  /* ============================================
     PORTFOLIO STACK (slide 3: iconos de tech)
  ============================================ */
  .portfolio-stack {
    display: flex;
    justify-content: space-between;
    gap: 2rem;
    margin-top: 5%;
    margin-bottom: 2rem;
    padding-right: .6rem;
  }

  .stack-group {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: .55rem;
  }

  .stack-label {
    font-size: .69rem;
  color: rgb(var(--accent-rgb-alt)) !important;
    text-align: center;
  }

  .stack-icons {
    display: flex;
    gap: .75rem;
    align-items: center;
  }

  .stack-icons img {
    width: 24px;
    height: 24px;
  }

  .astro-icon {
    filter: brightness(0) invert(1);
  }

  .old-portfolio-link {
    position: relative;
    display: inline-block;
   color: var(--accent-90); 
    font-weight: 700;
  }

  .old-portfolio-link::after {
    content: "";
    position: absolute;
    top: 180%;
    left: 50%;
    transform: translateX(-50%) translateY(-8px) scale(0.95);
    width: 270px;
    height: 140px;
    background-image: var(--preview-img);
    background-size: cover;
    background-position: center;
    border-radius: 8px;
    border: 2px solid rgba(255, 255, 255, 0.1);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.4);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 0.2s ease, transform 0.2s ease, visibility 0.2s;
    z-index: 50;
  }

  .old-portfolio-link:hover::after {
    opacity: 1;
    visibility: visible;
    transform: translateX(-50%) translateY(-14px) scale(1);
  }

  /* ============================================
     SLIDER (track + slides)
  ============================================ */
  .slider {
    position: relative;
    overflow: hidden;
    min-height: 90px;
  }

  .slider-track {
    display: flex;
    width: 300%;
    transition: transform 0.45s cubic-bezier(0.65, 0, 0.35, 1);
    will-change: transform;
  }

  .slide {
    flex: 0 0 33.3333%;
    min-width: 0;
  }

  /* ============================================
     SLIDER FOOTER (líneas indicadoras / navegación)
  ============================================ */
  .slider-footer {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
  }

  .slider-lines {
    display: flex;
    align-items: center;
    gap: 4px;
  }

  .slider-line {
  position: relative;
  width: 22px;
  height: 2px;
  border-radius: 1px;
  background: rgba(255, 255, 255, 0.25);
  cursor: pointer;
  transition: background 0.25s ease, width 0.25s ease;
}

.slider-line::before {
  content: "";
  position: absolute;
  top: -10px;
  bottom: -10px;
  left: -4px;
  right: -4px;
}

  .slider-line.is-active {
    width: 28px;
    background: var(--accent-85);
  }

  /* ============================================
     RESPONSIVE
  ============================================ */
  @media (max-width: 500px) {
    .about-body {
      flex-direction: column;
      align-items: center;
    }
    .about-text h1 {
      font-size: 1rem;
    }
  }
</style>
<script>
  function initAboutSlider() {
    const track = document.getElementById('about-track');
    if (!track || track.dataset.initialized) return;
    track.dataset.initialized = 'true';

    const slider = document.getElementById('about-slider');
    const slides = Array.from(track.children);
    const lines = Array.from(document.querySelectorAll<HTMLElement>('#about-lines .slider-line'));
    let current = 0;

    document.querySelectorAll<HTMLElement>('.old-portfolio-link').forEach((link) => {
      const img = link.dataset.preview;
      if (img) {
        link.style.setProperty('--preview-img', `url(${img})`);
      }
    });

    function updateLines() {
      lines.forEach((line, i) => {
        line.classList.toggle('is-active', i === current);
      });
    }

    function render() {
      (track as HTMLElement).style.transform = `translateX(-${current * (100 / slides.length)}%)`;
      updateLines();
    }

    function goTo(index: number) {
      current = Math.max(0, Math.min(slides.length - 1, index));
      render();
    }

    lines.forEach((line) => {
      line.addEventListener('click', () => {
        current = Number(line.dataset.index);
        render();
      });
    });

    // ===== Swipe táctil (mobile) =====
    let startX = 0;
    let startY = 0;
    let deltaX = 0;
    let isDragging = false;
    const SWIPE_THRESHOLD = 40; // px mínimos para considerar swipe

    slider?.addEventListener('touchstart', (e: TouchEvent) => {
      const touch = e.touches[0];
      startX = touch.clientX;
      startY = touch.clientY;
      deltaX = 0;
      isDragging = true;
      (track as HTMLElement).style.transition = 'none';
    }, { passive: true });

    slider?.addEventListener('touchmove', (e: TouchEvent) => {
      if (!isDragging) return;
      const touch = e.touches[0];
      deltaX = touch.clientX - startX;
      const deltaY = touch.clientY - startY;

      // Si el gesto es más vertical que horizontal, dejamos que scrollee la página
      if (Math.abs(deltaY) > Math.abs(deltaX)) return;

      const percentPerSlide = 100 / slides.length;
      const dragPercent = (deltaX / (slider as HTMLElement).offsetWidth) * percentPerSlide;
      (track as HTMLElement).style.transform =
        `translateX(-${current * percentPerSlide - dragPercent}%)`;
    }, { passive: true });

    slider?.addEventListener('touchend', () => {
      if (!isDragging) return;
      isDragging = false;
      (track as HTMLElement).style.transition = '';

      if (Math.abs(deltaX) > SWIPE_THRESHOLD) {
        if (deltaX < 0) {
          goTo(current + 1); // swipe izquierda -> siguiente
        } else {
          goTo(current - 1); // swipe derecha -> anterior
        }
      } else {
        render(); // vuelve al slide actual si no superó el umbral
      }

      deltaX = 0;
    });

    (track as HTMLElement).style.transition = 'none';
    render();
    requestAnimationFrame(() => {
      (track as HTMLElement).style.transition = '';
    });
  }

  document.addEventListener('astro:page-load', initAboutSlider);
  initAboutSlider();
</script>