---
import WinGlass from '../ui/WinGlass.astro';

const { title, projectTitle, description, projectUrl, codeUrl, tech, color } = Astro.props;
---
<div class="project-card">
<WinGlass title={title} color={color}>
  <div class="project-header">
  <strong class="project-title">{projectTitle}</strong>
  <div class="project-links">
    <a href={projectUrl} target="_blank" role="button">Demo</a>
    <a href={codeUrl} target="_blank" role="button">Código</a>
    <a href={codeUrl} target="_blank" role="button">Info</a>
  </div>
</div>
<p>{description}</p>
<div class="tech-badges">
  {tech.map((t: string) => <span class="badge">{t}</span>)}
</div>
</WinGlass>
</div>
<style>
:global(.project-card .window-body) {
  padding-left: .5rem !important;
  padding-block: .5rem !important;
  display: flex;
  flex-direction: column;
}

.project-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12px;
}

.project-title {
   font-size: 1.030rem; 
  }
p 
{ font-size: .905rem; 
  line-height: 1.1; 
  margin-top: .3rem;
  margin-bottom: .3rem;
}

.project-links { 
  display: flex; 
  gap: 6px; 
}

.project-links a[role="button"] {
  display: inline-flex !important;
  align-items: center !important;
  justify-content: center !important;
  text-align: center !important;
}

.tech-badges { 
  display: flex; 
  flex-wrap: wrap; 
  gap: 4px; 
  margin-top: 10px; 
  margin-bottom: 8px; 
}

.badge { 
  font-size: 10px; 
  padding: 1px 6px;
  background: #dce8f5;
  border: 1px solid #7ba7d4;
  border-radius: 0;
  color: #003366;
  font-weight: 600;
  box-shadow: inset 0 1px 0 #fff, inset 0 -1px 0 #aac4de;
}
</style>