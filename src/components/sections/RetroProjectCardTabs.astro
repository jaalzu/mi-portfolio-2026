---
import WinGlass from '../ui/WinGlass.astro';

const { title, projectTitle, description, projectUrl, codeUrl,  color, images, origin, techDetail, xp = false } = Astro.props;

const id = projectTitle.replace(/\s+/g, '-').toLowerCase();

---

<div class="project-card" >
<WinGlass title={title} color={color} {xp} icon="retro/projects2-8.webp">
  <section class="tabs">
    <menu role="tablist">
      <button role="tab" aria-controls={`${id}-overview`} aria-selected="true">Overview</button>
      <button role="tab" aria-controls={`${id}-tech`}>Stack</button>
      <button role="tab" aria-controls={`${id}-images`}>Imágenes</button>
      <button role="tab" aria-controls={`${id}-origin`}>Origen</button>
    </menu>

    <article role="tabpanel" id={`${id}-overview`}>
      <strong class="project-title">{projectTitle}</strong>
      <p>{description}</p>
    </article>

  <article role="tabpanel" id={`${id}-tech`} hidden>
  <ul class="tree-view has-container">
    {Object.entries(techDetail ?? {}).map(([category, items]: [string, any]) => (
      <li>
        <details>
          <summary>{category}</summary>
          <ul>
            {Array.isArray(items) 
              ? items.map((item: string) => <li>{item}</li>)
              : <li>{items}</li>
            }
          </ul>
        </details>
      </li>
    ))}
  </ul>
</article>

<article role="tabpanel" id={`${id}-images`} hidden>
 <div class="img-viewer">
<div class="img-nav">
  <button class="img-prev" id={`${id}-prev`}>
    <svg width="10" height="10" viewBox="0 0 10 14" fill="none" xmlns="http://www.w3.org/2000/svg">
      <path d="M8 1L2 7L8 13" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
    </svg>
  </button>
  <p class="img-counter" id={`${id}-counter`}>1 / {images?.length}</p>
  <button class="img-next" id={`${id}-next`}>
    <svg width="10" height="10" viewBox="0 0 10 14" fill="none" xmlns="http://www.w3.org/2000/svg">
      <path d="M2 1L8 7L2 13" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
    </svg>
  </button>
</div>
  <img 
    id={`${id}-img`}
    src={images?.[0]}
    data-images={images?.join(',')}
    alt={projectTitle}
    class="project-img"
  />
</div>
</article>

    <article role="tabpanel" id={`${id}-origin`} hidden>
      <p>{origin}</p>
    </article>

  </section>

  <section style="display: flex; justify-content: flex-end; gap: 6px; margin-top: 8px;">
    <a href={projectUrl} target="_blank" role="button" >Sitio web</a>
    <a href={codeUrl} target="_blank" role="button">Código</a>
  </section>

</WinGlass>
</div>



<style>
 

  .project-title {
    display: block;
    font-size: 1rem;
    margin-bottom: 8px;
  }

  p {
    font-size: .88rem;
    margin: 0 0 0px;
  }

  section a[role="button"] {
    text-decoration: none;
  display: inline-flex !important;
  align-items: center !important;
  justify-content: center !important;
}



  /* Stack */
  .tech-list {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .tech-row {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .badge {
    font-size: 10px;
    padding: 1px 6px;
    background: #dce8f5;
    border: 1px solid #7ba7d4;
    font-weight: 600;
    box-shadow: inset 0 1px 0 #fff, inset 0 -1px 0 #aac4de;
    white-space: nowrap;
    min-width: 75px;
    text-align: center;
  }

  .tech-use {
    font-size: .82rem;
    color: #222;
  }

  /* Imágenes */
.img-viewer {
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.img-nav {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.project-img {
  width: 100%;
  height: 162px;
  object-fit: cover;
  object-position: top;
  border: 1px solid #aaa;
}

.img-prev, .img-next {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 2px 11px;
  min-width: 18px;
}

.img-counter {
  text-align: center;
  font-size: .8rem;
  margin: 4px 0 0;
}
</style>













