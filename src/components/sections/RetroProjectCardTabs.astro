---
import WinGlass from '../ui/WinGlass.astro';
import StackAccordion from '../ui/StackAccordion.astro';

const { title, titleKey, projectTitle, description, descKey, projectUrl, codeUrl, color, images, origin, originKey, techKeys, xp = false } = Astro.props;

const id = projectTitle.replace(/\s+/g, '-').toLowerCase();
---

<div class="project-card">
<WinGlass noControls title={title} titleKey={titleKey} color={color} {xp} icon="retro/projects2-8.webp" colorTitle>
  <section class="tabs">
    <div class="tabs-header">
      <menu role="tablist">
        <button role="tab" aria-controls={`${id}-overview`} aria-selected="true" data-i18n="tabOverview">Overview</button>
        <button role="tab" aria-controls={`${id}-tech`} data-i18n="tabStack">Stack</button>
        <button role="tab" aria-controls={`${id}-images`} data-i18n="tabImages">Imágenes</button>
        <button role="tab" aria-controls={`${id}-origin`} data-i18n="tabOrigin">Origen</button>
      </menu>

      <div class="img-dots" role="group" aria-label="Imágenes del proyecto" hidden></div>
    </div>

    <div class="tabs-container">
      <article role="tabpanel" id={`${id}-overview`}>
        <p data-i18n={descKey}>{description}</p>
      </article>

      <article role="tabpanel" id={`${id}-tech`} hidden>
        <StackAccordion techKeys={techKeys} containerId={id} />
      </article>

      <article role="tabpanel" id={`${id}-images`} hidden>
        <div class="img-viewer">
          <div class="img-frame">
            <img
              id={`${id}-img`}
              src={images?.[0]}
              data-images={images?.join(',')}
              alt={projectTitle}
              class="project-img"
            />
          </div>
        </div>
      </article>

      <article role="tabpanel" id={`${id}-origin`} hidden>
        <p data-i18n={originKey}>{origin}</p>
      </article>
    </div>
  </section>

  <section style="display: flex; justify-content: flex-end; gap: 6px; margin-top: 8px;">
  <button class="icon-btn" onclick={`window.open('${projectUrl}', '_blank')`}>
  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 256 256">
    <path d="M240,88.23a54.43,54.43,0,0,1-16,37L189.25,160a54.27,54.27,0,0,1-38.63,16h-.05A54.63,54.63,0,0,1,96,119.84a8,8,0,0,1,16,.45A38.62,38.62,0,0,0,150.58,160h0a38.39,38.39,0,0,0,27.31-11.31l34.75-34.75a38.63,38.63,0,0,0-54.63-54.63l-11,11A8,8,0,0,1,135.7,59l11-11A54.65,54.65,0,0,1,224,48,54.86,54.86,0,0,1,240,88.23ZM109,185.66l-11,11A38.41,38.41,0,0,1,70.6,208h0a38.63,38.63,0,0,1-27.29-65.94L78,107.31A38.63,38.63,0,0,1,144,135.71a8,8,0,0,0,16,.45A54.86,54.86,0,0,0,144,96a54.65,54.65,0,0,0-77.27,0L32,130.75A54.62,54.62,0,0,0,70.56,224h0a54.28,54.28,0,0,0,38.64-16l11-11A8,8,0,0,0,109,185.66Z" fill="currentColor"/>
  </svg>
  <span data-i18n="btnSite">Sitio web</span>
</button>

   <button class="icon-btn" onclick={`window.open('${codeUrl}', '_blank')`}>
  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 256 256">
    <path d="M208.31,75.68A59.78,59.78,0,0,0,202.93,28,8,8,0,0,0,196,24a59.75,59.75,0,0,0-48,24H124A59.75,59.75,0,0,0,76,24a8,8,0,0,0-6.93,4,59.78,59.78,0,0,0-5.38,47.68A58.14,58.14,0,0,0,56,104v8a56.06,56.06,0,0,0,48.44,55.47A39.8,39.8,0,0,0,96,192v8H72a24,24,0,0,1-24-24A40,40,0,0,0,8,136a8,8,0,0,0,0,16,24,24,0,0,1,24,24,40,40,0,0,0,40,40H96v16a8,8,0,0,0,16,0V192a24,24,0,0,1,48,0v40a8,8,0,0,0,16,0V192a39.8,39.8,0,0,0-8.44-24.53A56.06,56.06,0,0,0,216,112v-8A58.14,58.14,0,0,0,208.31,75.68ZM200,112a40,40,0,0,1-40,40H112a40,40,0,0,1-40-40v-8a41.74,41.74,0,0,1,6.9-22.48A8,8,0,0,0,80,73.83a43.81,43.81,0,0,1,.79-33.58,43.88,43.88,0,0,1,32.32,20.06A8,8,0,0,0,119.82,64h32.35a8,8,0,0,0,6.74-3.69,43.87,43.87,0,0,1,32.32-20.06A43.81,43.81,0,0,1,192,73.83a8.09,8.09,0,0,0,1,7.65A41.72,41.72,0,0,1,200,104Z" fill="currentColor"/>
  </svg>
  <span data-i18n="btnCode">Código</span>
</button>
  </section>
</WinGlass>
</div>

<script is:inline>
  (() => {
    function initTabs() {
      document.querySelectorAll('.tabs:not([data-initialized])').forEach(container => {
        const tabsContainer = container.querySelector('.tabs-container');
        const tabs = container.querySelectorAll('[role="tab"]');
        const panels = container.querySelectorAll('[role="tabpanel"]');
        const dotsContainer = container.querySelector('.img-dots');

        const isImagesPanel = (panel) => !!panel?.querySelector('.img-viewer');

        const syncDotsVisibility = (activePanel) => {
          if (!dotsContainer) return;
          const onImagesTab = isImagesPanel(activePanel);
          const hasMultiple = dotsContainer.dataset.hasMultiple !== 'false';
          dotsContainer.hidden = !(onImagesTab && hasMultiple);
        };

        const updateContainerHeight = (panel) => {
          if (!tabsContainer) return;

          // Si el panel está hidden, usar altura 0
          if (panel.hidden) {
            tabsContainer.style.height = '0px';
            return;
          }

          // Esperar a que el DOM se actualice
          requestAnimationFrame(() => {
            const height = panel.scrollHeight;
            tabsContainer.style.height = height + 'px';
          });
        };

        // Crear un ResizeObserver para monitorear cambios de tamaño en el panel activo
        const resizeObserver = new ResizeObserver(() => {
          const activePanel = Array.from(panels).find(p => !p.hidden);
          if (activePanel) {
            updateContainerHeight(activePanel);
          }
        });

        // Observar todos los panels
        panels.forEach(panel => {
          resizeObserver.observe(panel);
        });

        tabs.forEach((tab, index) => {
          tab.addEventListener('click', (e) => {
            e.preventDefault();
            const targetId = tab.getAttribute('aria-controls');
            const activePanel = document.getElementById(targetId);

            // Desactivar todos los tabs
            tabs.forEach(t => t.setAttribute('aria-selected', 'false'));
            panels.forEach(p => p.hidden = true);

            // Activar el nuevo tab
            tab.setAttribute('aria-selected', 'true');
            if (activePanel) {
              activePanel.hidden = false;
              updateContainerHeight(activePanel);
            }
            syncDotsVisibility(activePanel);
          });
        });

        // Inicializar altura del primer panel
        const firstPanel = panels[0];
        if (firstPanel && !firstPanel.hidden) {
          updateContainerHeight(firstPanel);
        }
        syncDotsVisibility(firstPanel);

        container.setAttribute('data-initialized', 'true');
      });
    }

    function initImageViewers() {
      document.querySelectorAll('.img-viewer:not([data-initialized])').forEach(viewer => {
        const img = viewer.querySelector('.project-img');
        if (!img) return;

        const images = img.getAttribute('data-images')?.split(',').filter(Boolean) ?? [];
        const tabsRoot = viewer.closest('.tabs');
        const dotsContainer = tabsRoot?.querySelector('.img-dots');

        let current = 0;
        let dots = [];

        const updateImage = (index, { animate = true } = {}) => {
          current = (index + images.length) % images.length;
          img.src = images[current];

          dots.forEach((dot, i) => {
            dot.classList.toggle('is-active', i === current);
            dot.setAttribute('aria-selected', i === current ? 'true' : 'false');
            dot.tabIndex = i === current ? 0 : -1;
          });

          if (animate) {
            img.classList.remove('is-fading');
            // forzar reflow para reiniciar la animación
            void img.offsetWidth;
            img.classList.add('is-fading');
          }
        };

        if (dotsContainer && images.length > 1) {
          dotsContainer.dataset.hasMultiple = 'true';
          images.forEach((_, i) => {
            const dot = document.createElement('span');
            dot.className = i === 0 ? 'img-dot is-active' : 'img-dot';
            dot.setAttribute('aria-label', `Imagen ${i + 1} de ${images.length}`);
            dot.setAttribute('aria-selected', i === 0 ? 'true' : 'false');
            dot.tabIndex = i === 0 ? 0 : -1;
            dot.addEventListener('click', (e) => {
              e.preventDefault();
              updateImage(i);
            });
            dot.addEventListener('keydown', (e) => {
              if (e.key === 'Enter' || e.key === ' ') {
                e.preventDefault();
                updateImage(i);
              }
            });
            dotsContainer.appendChild(dot);
            dots.push(dot);
          });
        } else if (dotsContainer) {
          dotsContainer.dataset.hasMultiple = 'false';
        }

        // Swipe táctil simple
        let touchStartX = 0;
        viewer.addEventListener('touchstart', (e) => {
          touchStartX = e.changedTouches[0].screenX;
        }, { passive: true });

        viewer.addEventListener('touchend', (e) => {
          const touchEndX = e.changedTouches[0].screenX;
          const diff = touchEndX - touchStartX;
          if (Math.abs(diff) < 40) return;
          if (diff < 0) updateImage(current + 1);
          else updateImage(current - 1);
        }, { passive: true });

        viewer.setAttribute('data-initialized', 'true');
      });
    }

    function loadDeferredImages() {
      document.querySelectorAll('.project-img').forEach(img => {
        const deferredSrc = img.getAttribute('data-src');
        if (deferredSrc) {
          img.src = deferredSrc;
          img.removeAttribute('data-src');
        }
      });
    }

    function init() {
      initImageViewers();
      initTabs();
      if ('requestIdleCallback' in window) {
        window.requestIdleCallback(loadDeferredImages);
      } else {
        setTimeout(loadDeferredImages, 1);
      }
    }

    init();
    document.addEventListener('astro:page-load', init);
  })();
</script>

<style>
  .project-title {
    display: block;
    color: rgb(77, 255, 0);
    font-size: 1.040rem;
    font-weight: 700;
    margin-bottom: 3px;
    text-shadow: 3px 3px 1px rgba(0, 0, 0, 0.250);
    letter-spacing: .45px;
  }

  .tabs-container {
    height: auto;
    overflow: hidden;
    transition: height 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  }

  article[role="tabpanel"] {
    background: transparent !important;
    border: none !important;
    box-shadow: none !important;
    padding: 4px 2px !important;
    overflow-x: hidden !important;
    box-sizing: border-box !important;
    max-width: 100%;
    opacity: 1;
    animation: fadeIn 0.3s ease-out 0.1s both;
  }

  article[role="tabpanel"][hidden] {
    display: none;
  }

  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: translateY(-8px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .tabs {
    border: none !important;
  }

  .tabs-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    margin: 0 0 4px;
  }

  menu[role="tablist"] {
    background: transparent !important;
    border: none !important;
    display: flex;
    gap: 6px;
    padding: 0 !important;
    margin: 0 !important;
    flex-wrap: wrap;
  }

  button[role="tab"] {
    all: unset;
    display: inline-flex;
    align-items: center;
    cursor: pointer;
    background: rgba(255, 255, 255, 0.22) !important;
    backdrop-filter: blur(15px) !important;
    -webkit-backdrop-filter: blur(15px) !important;
    border: 1px solid rgba(255, 255, 255, 0) !important;
    text-shadow: 2px 2px 1px rgba(0, 0, 0, 0.130);
    color: inherit;
    font-weight: 600 !important;
    padding: .250rem .7rem !important;
    font-size: .75rem;
    clip-path: inset(0 round 999px) !important;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1) !important;
  }

  button[role="tab"]:hover,
  button[role="tab"]:focus,
  button[role="tab"]:active {
    background: rgba(255, 255, 255, 0.13) !important;
    outline: none !important;
    box-shadow: none !important;
    clip-path: inset(0 round 999px) !important;
  }

  button[role="tab"][aria-selected="true"] {
    background: rgba(255, 255, 255, 0.16) !important;
    border-color: rgba(255, 255, 255, 0.3) !important;
    scale: 1.05;
    filter: drop-shadow(0 0 8px rgba(255, 255, 255, 0.2));
  }

  button {
    background: transparent !important;
    font-weight: 600 !important;
    padding: .250rem .7rem !important;
    outline: none !important;
  }

  p {
    font-size: .790rem;
    font-weight: 600;
    text-shadow: 2px 2px 1px rgba(0, 0, 0, 0.120);
    line-height: 1.3;
    margin: 0 0 0px;
  }

  .icon-btn {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: .350rem .7rem !important;
  }

  .icon-btn svg {
    flex-shrink: 0;
  }

  /* ---------- Image viewer ---------- */

  .img-viewer {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .img-frame {
    position: relative !important;
    width: 100%;
  }

  .project-img {
    display: block !important;
    width: 100%;
    height: 180px;
    object-fit: cover;
    border-radius: 10px;
    object-position: top;
  }

  .project-img.is-fading {
    animation: imgFade 0.35s ease-out;
  }

  @keyframes imgFade {
    from {
      opacity: 0.35;
      filter: blur(4px);
    }
    to {
      opacity: 1;
      filter: blur(0);
    }
  }

  /* Contenedor de dots — solo layout, sin fondo propio */
  :global(.img-dots) {
    all: revert;
    position: static !important;
    flex-shrink: 0 !important;
    z-index: 5 !important;
    display: flex !important;
    flex-direction: row !important;
    justify-content: center !important;
    align-items: center !important;
    gap: 7px !important;
    padding: 0 !important;
    margin: 0 !important;
    width: fit-content !important;
    height: auto !important;
    background: transparent !important;
    backdrop-filter: none !important;
    -webkit-backdrop-filter: none !important;
    border: none !important;
    box-shadow: none !important;
  }

  :global(.img-dots[hidden]) {
    display: none !important;
  }

  :global(.img-dots.img-dots .img-dot.img-dot) {
    display: inline-block !important;
    box-sizing: border-box !important;
    appearance: none !important;
    -webkit-appearance: none !important;
    cursor: pointer !important;
    width: 12px !important;
    height: 12px !important;
    min-width: 0 !important;
    max-width: 12px !important;
    min-height: 0 !important;
    max-height: 12px !important;
    flex-shrink: 0 !important;
    padding: 0 !important;
    margin: 0 !important;
    border: 1px solid rgba(255, 255, 255, 0.3) !important;
    border-radius: 999px !important;
    background-color: rgba(255, 255, 255, 0.18) !important;
    background-image: none !important;
    backdrop-filter: blur(6px) saturate(160%) !important;
    -webkit-backdrop-filter: blur(6px) saturate(160%) !important;
    box-shadow:
      inset 0 1px 1px rgba(255, 255, 255, 0.35),
      inset 0 -1px 2px rgba(0, 0, 0, 0.1),
      0 1px 3px rgba(0, 0, 0, 0.15) !important;
    font: inherit !important;
    line-height: 0 !important;
    text-align: center !important;
    transition:
      width 0.35s cubic-bezier(0.4, 0, 0.2, 1),
      background-color 0.3s ease,
      box-shadow 0.3s ease,
      border-color 0.3s ease,
      transform 0.2s ease !important;
  }

  :global(.img-dots .img-dot::before),
  :global(.img-dots .img-dot::after) {
    content: none !important;
    display: none !important;
    background: none !important;
    box-shadow: none !important;
  }

  :global(.img-dots.img-dots .img-dot.img-dot:hover) {
    background-color: rgba(255, 255, 255, 0.32) !important;
    border-color: rgba(255, 255, 255, 0.5) !important;
    transform: scale(1.12) !important;
  }

  :global(.img-dots .img-dot:focus-visible) {
    outline: 2px solid rgba(255, 255, 255, 0.6) !important;
    outline-offset: 2px !important;
  }

  :global(.img-dots.img-dots .img-dot.img-dot.is-active) {
    width: 17px !important;
    background-color: rgba(77, 255, 0, 0.28) !important;
    border-color: rgba(77, 255, 0, 0.65) !important;
    box-shadow:
      inset 0 1px 1px rgba(255, 255, 255, 0.4),
      inset 0 -1px 2px rgba(0, 0, 0, 0.1) !important;
  }

  :global(.img-dots .img-dot.is-active:hover) {
    transform: none !important;
  }
</style>