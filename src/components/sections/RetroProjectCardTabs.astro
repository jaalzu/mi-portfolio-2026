---
import WinGlass from '../ui/WinGlass.astro';
import { translations } from '../../lib/translations';

const { title, titleKey, projectTitle, description, descKey, projectUrl, codeUrl, color, images, origin, originKey, techKeys, xp = false } = Astro.props;

const id = projectTitle.replace(/\s+/g, '-').toLowerCase();
---

<div class="project-card" data-tech-keys={JSON.stringify(techKeys)}>
<WinGlass title={title} titleKey={titleKey} color={color} {xp} icon="retro/projects2-8.webp">
  <section class="tabs">
  <menu role="tablist">
  <button 
    role="tab" 
    aria-controls={`${id}-overview`} 
    aria-selected="true" 
    data-i18n="tabOverview"
  >
    Overview
  </button>
  
  <button 
    role="tab" 
    aria-controls={`${id}-tech`} 
    data-i18n="tabStack"
  >
    Stack
  </button>
  
  <button 
    role="tab" 
    aria-controls={`${id}-images`} 
    data-i18n="tabImages"
  >
    Imágenes
  </button>
  
  <button 
    role="tab" 
    aria-controls={`${id}-origin`} 
    data-i18n="tabOrigin"
  >
    Origen
  </button>
</menu>

    <article role="tabpanel" id={`${id}-overview`}>
      <strong class="project-title">{projectTitle}</strong>
      <p data-i18n={descKey}>{description}</p>
    </article>

   <article role="tabpanel" id={`${id}-tech`} hidden data-tech-container={id}>
      <ul class="tree-view has-container">
        <!-- Se llenará dinámicamente con JS -->
      </ul>
    </article>

    <article role="tabpanel" id={`${id}-images`} hidden>
      <div class="img-viewer">
        <div class="img-nav">
          <button class="img-prev" id={`${id}-prev`}>
            <svg width="10" height="10" viewBox="0 0 10 14" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M8 1L2 7L8 13" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
            </svg>
          </button>
          <p class="img-counter" id={`${id}-counter`}>1 / {images?.length}</p>
          <button class="img-next" id={`${id}-next`}>
            <svg width="10" height="10" viewBox="0 0 10 14" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M2 1L8 7L2 13" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
            </svg>
          </button>
        </div>
        <img
          id={`${id}-img`}
          src={images?.[0]}
          data-images={images?.join(',')}
          alt={projectTitle}
          class="project-img"
        />
      </div>
    </article>

    <article role="tabpanel" id={`${id}-origin`} hidden>
      <p data-i18n={originKey}>{origin}</p>
    </article>

  </section>

<section style="display: flex; justify-content: flex-end; gap: 6px; margin-top: 8px;">
  <button class="icon-btn" onclick={`window.open('${projectUrl}', '_blank')`}>
    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
      <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
      <path d="M15 3h6v6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
      <path d="M10 14L21 3" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
    <span data-i18n="btnSite">Sitio web</span>
  </button>

  <button class="icon-btn" onclick={`window.open('${codeUrl}', '_blank')`}>
    <svg width="13" height="13" viewBox="0 0 16 16" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
      <path fill-rule="evenodd" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0 0 16 8c0-4.42-3.58-8-8-8Z"/>
    </svg>
    <span data-i18n="btnCode">Código</span>
  </button>
</section>

</WinGlass>
</div>


<script is:inline define:vars={{ translations }}>
  (() => {
    // Renderizado de detalles técnicos (Stack)
    const renderTechDetail = (container, techKeys, lang = 'es') => {
      const ul = container.querySelector('ul');
      if (!ul) return;
      ul.innerHTML = '';

      Object.entries(techKeys).forEach(([category, key]) => {
        const items = translations[lang][key] || [];
        const li = document.createElement('li');
        li.innerHTML = `
          <details>
            <summary>${category}</summary>
            <ul>
              ${Array.isArray(items) 
                ? items.map(item => `<li>${item}</li>`).join('')
                : `<li>${items}</li>`
              }
            </ul>
          </details>
        `;
        ul.appendChild(li);
      });
    };

    const initProjects = () => {
      const currentLang = document.documentElement.getAttribute('lang') || 'es';

      // 1. Inicializar Tech Details
      document.querySelectorAll('[data-tech-container]:not([data-initialized])').forEach(container => {
        const card = container.closest('.project-card');
        const techKeys = card ? JSON.parse(card.getAttribute('data-tech-keys') || '{}') : {};
        renderTechDetail(container, techKeys, currentLang);
        container.setAttribute('data-initialized', 'true');
      });

      // 2. Inicializar Tabs (Lógica de navegación)
      document.querySelectorAll('.tabs:not([data-initialized])').forEach(container => {
        const tabs = container.querySelectorAll('[role="tab"]');
        const panels = container.querySelectorAll('[role="tabpanel"]');

        tabs.forEach(tab => {
          tab.addEventListener('click', (e) => {
            e.preventDefault();
            const targetId = tab.getAttribute('aria-controls');
            tabs.forEach(t => t.setAttribute('aria-selected', 'false'));
            panels.forEach(p => p.hidden = true);
            tab.setAttribute('aria-selected', 'true');
            const activePanel = document.getElementById(targetId);
            if (activePanel) activePanel.hidden = false;
          });
        });
        container.setAttribute('data-initialized', 'true');
      });

      // 3. Inicializar Image Viewers (Navegación de imágenes)
      document.querySelectorAll('.img-viewer:not([data-initialized])').forEach(viewer => {
        const img = viewer.querySelector('.project-img');
        if (!img) return;

        const images = img.getAttribute('data-images')?.split(',') ?? [];
        const counter = viewer.querySelector('.img-counter');
        const prevBtn = viewer.querySelector('.img-prev');
        const nextBtn = viewer.querySelector('.img-next');
        
        let current = 0;

        const updateImage = (index) => {
          current = (index + images.length) % images.length;
          img.src = images[current];
          if (counter) counter.textContent = `${current + 1} / ${images.length}`;
        };

        prevBtn?.addEventListener('click', (e) => {
          e.preventDefault();
          updateImage(current - 1);
        });

        nextBtn?.addEventListener('click', (e) => {
          e.preventDefault();
          updateImage(current + 1);
        });
        
        viewer.setAttribute('data-initialized', 'true');
      });

      // 4. CARGA DIFERIDA (BAJA PRIORIDAD)
      // Esta función se ejecuta cuando el thread principal está libre
      const loadProjectImages = () => {
        document.querySelectorAll('.project-img').forEach(img => {
          const deferredSrc = img.getAttribute('data-src');
          if (deferredSrc) {
            img.src = deferredSrc;
            // Opcional: remover el atributo una vez cargado
            img.removeAttribute('data-src');
          }
        });
      };

      // Usamos requestIdleCallback para enviarlo al final de la cola (Macrotask de baja prioridad)
      if ('requestIdleCallback' in window) {
        window.requestIdleCallback(() => loadProjectImages());
      } else {
        // Fallback para navegadores antiguos
        setTimeout(loadProjectImages, 1);
      }
    };

    // Ejecución inicial
    initProjects();

    // Compatibilidad con transiciones de Astro
    document.addEventListener('astro:page-load', initProjects);

    // Observer para cambios de idioma
    const originalApplyLang = window.applyLang;
    if (typeof window !== 'undefined' && originalApplyLang) {
      window.applyLang = function(lang, updateUrl = true) {
        originalApplyLang.call(this, lang, updateUrl);
        document.querySelectorAll('[data-tech-container]').forEach(container => {
          const card = container.closest('.project-card');
          const techKeys = card ? JSON.parse(card.getAttribute('data-tech-keys') || '{}') : {};
          renderTechDetail(container, techKeys, lang);
        });
      };
    }
  })();
</script>

<style>
  .project-title {
    display: block;
  color: rgb(249, 8, 8);
    font-size: 1rem;
    margin-bottom: 3px;
  }

article[role="tabpanel"] {
  background: transparent !important;
}

button{
  background: transparent !important;
  font-weight: 600 !important;
  padding: .250rem .7rem !important;
}

menu[role="tablist"],
button[role="tab"] {
  background: transparent !important;
}

.tree-view,
.tree-view li,
.tree-view details,
.tree-view summary {
  background: transparent !important;
  border: none !important;
    font-weight: 600 !important;

}

  p {
    font-size: .790rem;
    font-weight: 600;
    line-height: 1.3;
    margin: 0 0 0px;
  }

  .icon-btn {
  display: inline-flex;
  align-items: center;
  gap: 5px;
}

.icon-btn svg {
  flex-shrink: 0;
}


  .img-viewer {
    display: flex;
    flex-direction: column;
    gap: 1px;
  }

  .img-nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .project-img {
    width: 100%;
    height: 180px;
    object-fit: cover;
    border-radius: 3px;
    object-position: top;
  }

  .img-prev, .img-next {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 2px 11px;
    min-width: 18px;
  }

  .img-counter {
    text-align: center;
    font-size: .7rem;
    margin: 8px 0 0;
  }
</style>