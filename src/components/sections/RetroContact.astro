---
import WinGlass from '../ui/WinGlass.astro';
---

<WinGlass title="Contacto" noControls color="var(--win-contact)">
  <p>Podes contactarme por cualquiera de estos medios!</p>
  <span id="email-text">Ver correo</span>
  <div class="contact-links">
  <a href="https://github.com/jaalzu" target="_blank" role="button">GitHub</a>
  <a href="https://www.linkedin.com/in/javier-alz%C3%BA-332ab2261/" target="_blank" role="button">LinkedIn</a>
</div>
</WinGlass>

<style>
  .contact-links {
    display: flex;
    margin-top: 22px;
    margin-bottom: .6rem;
    gap: 8px;
    padding-left: .3rem;
  }

  p{
    padding-left: .3rem;

    font-size: 1rem;
}

.contact-links a {
  text-decoration: none;
  display: flex;
  padding: 6px 16px;
  font-weight: 500;
}
  #email-text { cursor: pointer; 
    padding-right: .4rem;
    padding-left: .3rem;

    padding-block: 4px;
    text-decoration: underline; 
    font-size: .8rem; 
  font-weight: 700;
  }
</style>

<script is:inline>
  const el = document.getElementById('email-text');
  const user = 'javieralzuu';
  const domain = 'gmail.com';
  const email = `${user}@${domain}`;

  el.addEventListener('mouseenter', () => {
    el.textContent = `${email} · click para copiar`;
  });

  el.addEventListener('mouseleave', () => {
    el.textContent = 'Ver correo';
  });

  el.addEventListener('click', () => {
    navigator.clipboard.writeText(email);
    el.textContent = '✓ Copiado!';
    setTimeout(() => { el.textContent = 'Ver correo'; }, 2000);
  });
</script>