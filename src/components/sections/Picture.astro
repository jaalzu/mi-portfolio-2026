---
import Card from '../ui/Card.astro';
import { Image } from 'astro:assets';
import miFoto from '../../assets/catcat.webp'; 
---

<Card>
  <Image 
    src={miFoto} 
    alt="Mi foto de Javier Alzú" 
    class="full-img" 
    loading="eager" 
    fetchpriority="high"
    quality="mid" 
    width={400} 
    height={400}
  />
</Card>

<style>
  .full-img {
    width: 100%;
    height: 100%;
    border-radius: 10px;
    display: block;
    object-fit: cover;
    /* Evitamos que la imagen se estire feo si el contenedor cambia */
    aspect-ratio: 1 / 1; 
  }
</style>