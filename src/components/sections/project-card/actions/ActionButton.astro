---
/**
 * ActionButton.astro
 * Átomo reusable: un botón con ícono que abre una URL en nueva pestaña.
 * "Sitio web" y "Código" son dos instancias de este mismo componente.
 */
interface Props {
  url: string;
  label: string;
  i18nKey?: string;
  Icon: any;
}



const { url, label, i18nKey, Icon } = Astro.props;
---

<button
  class="icon-btn tab-btn"
  data-open-url={url}
  data-tooltip={label}
  aria-label={label}
>
  <span class="icon-btn-icon tab-icon">
    <Icon />
  </span>
</button>
<style>
  /* Solo lo puntual de este componente: tamaño de ícono distinto al default */
  .icon-btn-icon {
    width: 19px;
    height: 19px;
  }

  .icon-btn-icon :global(svg) {
    width: 100%;
    height: 100%;
  }
</style>


<script>
  document.addEventListener("click", (e) => {
    const btn = (e.target as HTMLElement)?.closest<HTMLElement>("[data-open-url]");
    if (!btn) return;
    const url = btn.getAttribute("data-open-url");
    if (url) window.open(url, "_blank");
  });
</script>