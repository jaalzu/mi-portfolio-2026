---
import WinGlass from "../../ui/WinGlass.astro";
import Tabs from "./tabs/Tabs.astro";
import OverviewPanel from "./panels/OverviewPanel.astro";
import StackPanel from "./panels/StackPanel.astro";
import OriginPanel from "./panels/OriginPanel.astro";
import ProjectActions from "./actions/ProjectActions.astro";

interface Props {
  title?: string;
  titleKey?: string;
  projectTitle?: string;
  description?: string;
  descKey?: string;
  projectUrl: string;
  codeUrl: string;
  color: string;
  images: string[];
  origin: string;
  originKey?: string;
  techKeys: Record<string, string>;
  xp?: boolean;
  imagesFit?: "cover" | "contain";
}

const { title, titleKey, projectTitle, description, descKey, projectUrl, codeUrl, color, images, origin, originKey, techKeys, xp = false, imagesFit } = Astro.props;

const id = projectTitle.replace(/\s+/g, "-").toLowerCase();

const tabs: { id: string; label: string; i18nKey: string; iconType: "eye" | "stack" | "circle" }[] = [
  { id: "overview", label: "Overview", i18nKey: "tabOverview", iconType: "eye"    },
  { id: "tech",     label: "Stack",    i18nKey: "tabStack",    iconType: "stack"  },
  { id: "origin",   label: "Origen",   i18nKey: "tabOrigin",   iconType: "circle" },
];
---

<div class="project-card">
<WinGlass noControls noTitlebar title={title} titleKey={titleKey} color={color} xp={xp} icon="retro/projects2-8.webp" colorTitle>
    <Tabs containerId={id} tabs={tabs}>
      <ProjectActions slot="actions" projectUrl={projectUrl} codeUrl={codeUrl} />

      <OverviewPanel
        id={`${id}-overview`}
        hidden={false}
        projectTitle={projectTitle}
        titleKey={titleKey}
        images={images}
        imgId={`${id}-img`}
        fit={imagesFit}
      />
      <StackPanel id={`${id}-tech`} hidden={true} techKeys={techKeys} containerId={id} />
      <OriginPanel
        id={`${id}-origin`}
        hidden={true}
        description={description}
        descKey={descKey}
        origin={origin}
        originKey={originKey}
      />
    </Tabs>
  </WinGlass>
</div>