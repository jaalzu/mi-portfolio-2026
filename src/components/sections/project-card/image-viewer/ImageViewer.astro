---
import ImageFrame from "./ImageFrame.astro";
import ImageDots from "./ImageDots.astro";

interface Props {
  images: string[];
  heroImageEn?: string;
  alt?: string;
  imgId: string;
  fit?: "cover" | "contain";
}

const { images, heroImageEn, alt, imgId, fit } = Astro.props;
---

<div class="img-viewer">
  <ImageFrame images={images} heroImageEn={heroImageEn} alt={alt} imgId={imgId} fit={fit} />
  <div class="img-dots" role="group" aria-label="Imágenes del proyecto"></div>
</div>
<ImageDots />

<style>
  .img-viewer {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    margin-bottom: 10px;
  }
</style>

<script>
  import "../scripts/image-viewer-controller.js";
</script>