---
import ImageFrame from "./ImageFrame.astro";

interface Props {
  images: string[];
  alt: string;
  imgId: string;
  fit?: "cover" | "contain";
}

const { images, alt, imgId, fit } = Astro.props;
---

<div class="img-viewer">
  <ImageFrame images={images} alt={alt} imgId={imgId} fit={fit} />
</div>

<style>
  .img-viewer {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
</style>

<script>
  import "../scripts/image-viewer-controller.js";
</script>