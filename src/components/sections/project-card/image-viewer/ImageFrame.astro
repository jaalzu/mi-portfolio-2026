---
interface Props {
  images: string[];
  alt: string;
  imgId: string;
  fit?: "cover" | "contain";
}

const { images, alt, imgId, fit = "cover" } = Astro.props;
---

<div class="img-frame">
  <img
    id={imgId}
    src={images?.[0]}
    data-images={images?.join(",")}
    alt={alt}
    class="project-img"
    style={`object-fit: ${fit};`}
  />
</div>

<style>
  .img-frame {
    position: relative !important;
    width: 100%;
    background-color: rgba(0, 0, 0, 0.35);
    border-radius: 10px;
  }

  .project-img {
    display: block !important;
    width: 100%;
    height: 180px;
    border-radius: 10px;
    object-position: top;
  }

  .project-img.is-fading {
    animation: imgFade 0.35s ease-out;
  }

  @keyframes imgFade {
    from {
      opacity: 0.35;
      filter: blur(4px);
    }
    to {
      opacity: 1;
      filter: blur(0);
    }
  }
</style>