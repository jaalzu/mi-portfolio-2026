---
interface Props {
  controls: string;
  selected?: boolean;
  i18nKey?: string;
  label: string;
  IconDefault: any;
  IconHover: any;
}

const { controls, selected = false, i18nKey, label, IconDefault, IconHover } = Astro.props;
---

<div
  role="tab"
  tabindex="0"
  aria-controls={controls}
  aria-selected={selected ? "true" : "false"}
  class="tab-btn"
>
  <span class="tab-icon">
    <span class="tab-icon-layer is-default">
      <IconDefault />
    </span>
    <span class="tab-icon-layer is-hover">
      <IconHover />
    </span>
  </span>
  <span class="tab-label" data-i18n={i18nKey}>{label}</span>
</div>

<!-- is:global porque el scoped CSS de Astro no penetra hijos SVG importados -->
<style is:global>

  /* ─── base del tab ─────────────────────────────────────────────── */

  .tab-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    cursor: pointer;
    user-select: none;
    background: rgba(255, 255, 255, 0.10);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 999px;
    color: inherit;
    font-weight: 600;
    padding: 0.3rem 0.75rem;
    font-size: 0.75rem;
    transition: background 0.25s ease, border-color 0.25s ease;
  }

  .tab-btn:hover {
    background: rgba(255, 255, 255, 0.16);
    border-color: rgba(255, 255, 255, 0.22);
  }

  .tab-btn:focus-visible {
    outline: 2px solid rgba(255, 255, 255, 0.5);
    outline-offset: 2px;
  }

  .tab-btn[aria-selected="true"] {
    background: rgba(255, 255, 255, 0.22);
    border-color: rgba(255, 255, 255, 0.32);
  }

  /* ─── contenedor de icono ──────────────────────────────────────── */

  .tab-icon {
    position: relative;
    display: inline-flex;
    width: 14px;
    height: 14px;
    flex-shrink: 0;
    color: #fff;
    overflow: visible;
  }

  .tab-icon-layer {
    position: absolute;
    inset: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .tab-icon-layer svg {
    display: block;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  /* ─── estado reposo ────────────────────────────────────────────── */

  .is-default {
    animation: icon-out-reverse 0.4s cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  .is-hover {
    animation: icon-in-reverse 0.4s cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  /* ─── estado hover ─────────────────────────────────────────────── */

  .tab-btn:hover .is-default,
  .tab-btn:focus-visible .is-default {
    animation: icon-out 0.35s cubic-bezier(0.4, 0, 0.6, 1) both;
  }

  .tab-btn:hover .is-hover,
  .tab-btn:focus-visible .is-hover {
    animation: icon-in 0.45s cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  /* ─── keyframes del swap de icono ──────────────────────────────── */

  /* default sale: achica, opaca, sube */
  @keyframes icon-out {
    0%   { opacity: 1; transform: scale(1)    translateY(0px)   rotate(0deg); }
    100% { opacity: 0; transform: scale(0.3)  translateY(-7px)  rotate(-20deg); }
  }

  /* default vuelve cuando se va el hover */
  @keyframes icon-out-reverse {
    0%   { opacity: 0; transform: scale(0.3)  translateY(-7px)  rotate(-20deg); }
    100% { opacity: 1; transform: scale(1)    translateY(0px)   rotate(0deg); }
  }

  /* hover entra: crece desde abajo con bounce */
  @keyframes icon-in {
    0%   { opacity: 0; transform: scale(0.3)  translateY(7px)   rotate(20deg); }
    60%  { opacity: 1; transform: scale(1.15) translateY(-1px)  rotate(-3deg); }
    100% { opacity: 1; transform: scale(1)    translateY(0px)   rotate(0deg); }
  }

  /* hover vuelve a su estado oculto */
  @keyframes icon-in-reverse {
    0%   { opacity: 1; transform: scale(1)    translateY(0px)   rotate(0deg); }
    100% { opacity: 0; transform: scale(0.3)  translateY(7px)   rotate(20deg); }
  }

  /* ─── animaciones internas de los SVG ──────────────────────────── */

  /*
   * Cada SVG tiene partes animables. Las activamos cuando el tab-btn
   * está en hover Y la capa .is-hover ya entró.
   * Usamos animation-delay para que empiecen cuando el icono ya llegó.
   */

  /* ── EYE: el iris late una vez que aparece ── */
  .tab-btn:hover .is-hover svg circle,
  .tab-btn:focus-visible .is-hover svg circle {
    animation: iris-pulse 0.6s cubic-bezier(0.22, 1, 0.36, 1) 0.3s both;
    transform-origin: center;
    transform-box: fill-box;
  }

  @keyframes iris-pulse {
    0%   { transform: scale(0.4); opacity: 0; }
    60%  { transform: scale(1.2); opacity: 1; }
    100% { transform: scale(1);   opacity: 1; }
  }

  /* ── STACK: las líneas bajan escalonadamente ── */
  .tab-btn:hover .is-hover svg polyline:first-of-type,
  .tab-btn:focus-visible .is-hover svg polyline:first-of-type {
    animation: stack-drop 0.5s cubic-bezier(0.22, 1, 0.36, 1) 0.25s both;
    transform-origin: center top;
    transform-box: fill-box;
  }

  .tab-btn:hover .is-hover svg polyline:last-of-type,
  .tab-btn:focus-visible .is-hover svg polyline:last-of-type {
    animation: stack-drop 0.5s cubic-bezier(0.22, 1, 0.36, 1) 0.38s both;
    transform-origin: center top;
    transform-box: fill-box;
  }

  @keyframes stack-drop {
    0%   { opacity: 0; transform: translateY(-8px); }
    60%  { opacity: 1; transform: translateY(1px);  }
    100% { opacity: 1; transform: translateY(0);    }
  }

  /* ── CIRCLE: el stroke se dibuja girando ── */
  .tab-btn:hover .is-hover svg circle,
  .tab-btn:focus-visible .is-hover svg circle {
    stroke-dasharray: 603;
    stroke-dashoffset: 603;
    animation: circle-draw 0.6s cubic-bezier(0.22, 1, 0.36, 1) 0.25s forwards;
  }

  @keyframes circle-draw {
    to { stroke-dashoffset: 0; }
  }

  /* ── IMAGE: el frame se expande y las líneas aparecen ── */
  .tab-btn:hover .is-hover svg rect,
  .tab-btn:focus-visible .is-hover svg rect {
    animation: frame-expand 0.4s cubic-bezier(0.22, 1, 0.36, 1) 0.2s both;
    transform-origin: center;
    transform-box: fill-box;
  }

  @keyframes frame-expand {
    0%   { transform: scale(0.7); opacity: 0; }
    60%  { transform: scale(1.05); opacity: 1; }
    100% { transform: scale(1);   opacity: 1; }
  }

  .tab-btn:hover .is-hover svg path,
  .tab-btn:focus-visible .is-hover svg path {
    animation: lines-appear 0.4s ease-out 0.32s both;
  }

  @keyframes lines-appear {
    0%   { opacity: 0; transform: translateY(3px); }
    100% { opacity: 1; transform: translateY(0);   }
  }

  /* ─── reduced motion ───────────────────────────────────────────── */

  @media (prefers-reduced-motion: reduce) {
    .is-default,
    .is-hover,
    .tab-btn:hover .is-default,
    .tab-btn:hover .is-hover,
    .tab-btn:focus-visible .is-default,
    .tab-btn:focus-visible .is-hover,
    .tab-btn:hover .is-hover svg circle,
    .tab-btn:hover .is-hover svg polyline,
    .tab-btn:hover .is-hover svg rect,
    .tab-btn:hover .is-hover svg path {
      animation: none !important;
      opacity: inherit;
      transform: none !important;
    }
    .is-hover { opacity: 0; }
    .tab-btn:hover .is-default,
    .tab-btn:focus-visible .is-default { opacity: 0; }
    .tab-btn:hover .is-hover,
    .tab-btn:focus-visible .is-hover { opacity: 1; }
  }

</style>

<script>
  document.addEventListener("keydown", (e) => {
    if (e.key !== "Enter" && e.key !== " ") return;
    const tab = (e.target as HTMLElement)?.closest?.('[role="tab"]');
    if (!tab) return;
    e.preventDefault();
    tab.dispatchEvent(new MouseEvent("click", { bubbles: true }));
  });
</script>