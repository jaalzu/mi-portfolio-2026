<script>
import gsap from "gsap";

function getPathLength(el: SVGGeometryElement) {
  return el.getTotalLength();
}

function initTabIcons() {
  document.querySelectorAll<HTMLElement>('.tab-btn:not([data-gsap-ready])').forEach(btn => {
    btn.setAttribute("data-gsap-ready", "1");
    const type = btn.dataset.icon;
    const svg  = btn.querySelector("svg");
    if (!svg) return;

    const tlIn  = gsap.timeline({ paused: true });
    const tlOut = gsap.timeline({ paused: true });

   /* ── EYE ──────────────────────────────────────────────────────
       Reposo : eyelid + lashes visibles. eye-open e iris OCULTOS.
       Hover  : eyelid+lashes → 0, eye-open → 1, iris ya está ahí
                (opacity 1 desde el inicio, no aparece mágicamente)
    ────────────────────────────────────────────────────────────── */
if (type === "eye" && svg) {
  const lashesClosed = svg.querySelectorAll(".lash-closed");
  const lashesOpen   = svg.querySelectorAll(".lash-open");
  const eyelid  = svg.querySelector(".eyelid")!;
  const eyeOpen = svg.querySelector(".eye-open")!;
  const iris    = svg.querySelector(".iris")!;

  gsap.set([eyeOpen, iris, ...Array.from(lashesOpen)], { opacity: 0, immediateRender: true });

  tlIn
    .to([...Array.from(lashesClosed), eyelid], { opacity: 0, duration: 0.18, ease: "power2.in" }, 0)
    .to(eyeOpen,     { opacity: 1, duration: 0.22, ease: "power2.out" }, 0.15)
    .to(iris,        { opacity: 1, duration: 0.22, ease: "power2.out" }, 0.15)
    .to(lashesOpen,  { opacity: 1, duration: 0.22, ease: "power2.out" }, 0.15);

  tlOut
    .to([eyeOpen, iris, ...Array.from(lashesOpen)], { opacity: 0, duration: 0.15, ease: "power2.in" }, 0)
    .to([...Array.from(lashesClosed), eyelid], { opacity: 1, duration: 0.2, ease: "power2.out" }, 0.12);
}
 

  /* ── STACK ────────────────────────────────────────────────────
       Reposo : solo s-base visible.
       Hover  : s-base baja, cap1 cae primero (arriba), cap2 cae después (abajo).
       FIFO desde arriba: cap1 llega antes y queda en el top.
    ────────────────────────────────────────────────────────────── */
    if (type === "stack" && svg) {
      const sBase = svg.querySelector(".s-base")!;
      const cap1  = svg.querySelector(".s-cap1")!;
      const cap2  = svg.querySelector(".s-cap2")!;
      const icon  = btn.querySelector<HTMLElement>(".tab-icon")!;
 
      svg.style.overflow = "visible";
      icon.style.overflow = "visible";
 
      gsap.set(cap1, { opacity: 0, attr: { transform: "translate(0,-256)" }, immediateRender: true });
      gsap.set(cap2, { opacity: 0, attr: { transform: "translate(0,-256)" }, immediateRender: true });
      gsap.set(sBase, { attr: { transform: "translate(0,0)" }, immediateRender: true });
 
      tlIn
        // base baja para hacer espacio a las dos capas
        // cap1 cae primero — queda en el top
        .to(cap1,  { opacity: 1, attr: { transform: "translate(0,0)" }, duration: 0.42, ease: "back.out(2)" }, 0.04)
        // cap2 cae después — queda entre cap1 y base
        .to(cap2,  { opacity: 1, attr: { transform: "translate(0,10)" }, duration: 0.42, ease: "back.out(2)" }, 0.16);
 
      tlOut
        .to(cap2,  { opacity: 0, attr: { transform: "translate(0,-256)" }, duration: 0.18, ease: "power3.in" }, 0)
        .to(cap1,  { opacity: 0, attr: { transform: "translate(0,-256)" }, duration: 0.18, ease: "power3.in" }, 0.08)
    }

    /* ── CIRCLE ──────────────────────────────────────────────────
       Reposo: 6 arcos separados (dashed look)
       Hover:  arcos se mantienen, círculo completo se traza ENCIMA
               rellenando los huecos — de dashed a solid
    ──────────────────────────────────────────────────────────── */
    if (type === "circle") {
      const arcs  = svg.querySelectorAll<SVGPathElement>(".arc");
      const solid = svg.querySelector<SVGCircleElement>(".solid")!;
      const circ  = 2 * Math.PI * 96; // 603.18

      gsap.set(solid, { strokeDasharray: circ, strokeDashoffset: circ, opacity: 1 });

      tlIn
        // los arcos se atenúan suavemente mientras el solid se dibuja encima
        .to(arcs,  { opacity: 0.25, stagger: 0.025, duration: 0.15, ease: "power1.in" }, 0)
        .to(solid, { strokeDashoffset: 0,            duration: 0.6,  ease: "power2.out" }, 0.05)
        .to(arcs,  { opacity: 0,                     duration: 0.1                      }, 0.4);

      tlOut
        .to(solid, { strokeDashoffset: circ, duration: 0.35, ease: "power2.in" }, 0)
        .to(arcs,  { opacity: 1, stagger: 0.03, duration: 0.2, ease: "power1.out" }, 0.2);
    }

    /* ── IMAGE ───────────────────────────────────────────────────
       Reposo: frame + dot + montañas estáticos
       Hover:  dot sube y crece (sol que brilla),
               mount-a y mount-b se dibujan con stroke-dash
               frame hace un micro-bounce
    ──────────────────────────────────────────────────────────── */
    if (type === "image") {
      const frame  = svg.querySelector<SVGRectElement>(".frame")!;
      const dot    = svg.querySelector<SVGCircleElement>(".dot")!;
      const mountA = svg.querySelector<SVGPathElement>(".mount-a")!;
      const mountB = svg.querySelector<SVGPathElement>(".mount-b")!;

      const lenA = getPathLength(mountA);
      const lenB = getPathLength(mountB);

      // reset montañas al estado invisible para dibujarlas
      gsap.set(mountA, { strokeDasharray: lenA, strokeDashoffset: lenA });
      gsap.set(mountB, { strokeDasharray: lenB, strokeDashoffset: lenB });

      tlIn
        // frame bounce sutil
        .fromTo(frame,
          { scale: 1,    transformOrigin: "128px 128px" },
          { scale: 1.05, transformOrigin: "128px 128px", duration: 0.18, ease: "power2.out", yoyo: true, repeat: 1 }
        )
        // dot sube un poco y agranda
        .to(dot,
          { y: -6, scale: 1.4, transformOrigin: "156px 100px", duration: 0.35, ease: "back.out(2)" },
          0
        )
        // montañas se dibujan de izquierda a derecha
        .to(mountB, { strokeDashoffset: 0, duration: 0.5, ease: "power2.out" }, 0.08)
        .to(mountA, { strokeDashoffset: 0, duration: 0.4, ease: "power2.out" }, 0.2);

      tlOut
        .to(dot,    { y: 0, scale: 1, transformOrigin: "156px 100px", duration: 0.25, ease: "power2.in" }, 0)
        .to(mountA, { strokeDashoffset: lenA, duration: 0.25, ease: "power2.in" }, 0)
        .to(mountB, { strokeDashoffset: lenB, duration: 0.3,  ease: "power2.in" }, 0.04);
    }

  // ── eventos ──────────────────────────────────────────────────
const isSelected = () => btn.getAttribute("aria-selected") === "true";
let active = isSelected();
let hovered = false;

btn.addEventListener("mouseenter", () => { hovered = true;  if (!active) { tlOut.pause(); tlIn.restart(); } });
btn.addEventListener("mouseleave", () => { hovered = false; if (!active) { tlIn.pause(); tlOut.restart(); } });
btn.addEventListener("focus",      () => { if (!active && !hovered) { tlOut.pause(); tlIn.restart(); } });
btn.addEventListener("blur",       () => { if (!active) { tlIn.pause(); tlOut.restart(); } });

new MutationObserver((mutations) => {
  const changed = mutations[0].oldValue !== btn.getAttribute("aria-selected");
  if (!changed) return;
  active = isSelected();
  if (active) { tlOut.pause(); if (!hovered) tlIn.play(); }
  else        { tlIn.pause(); tlOut.restart(); }
}).observe(btn, { attributes: true, attributeFilter: ["aria-selected"], attributeOldValue: true });

if (isSelected()) { active = true; tlIn.progress(1); }
  });
}

initTabIcons();
document.addEventListener("astro:page-load", initTabIcons);

document.addEventListener("keydown", (e) => {
  if (e.key !== "Enter" && e.key !== " ") return;
  const tab = (e.target as HTMLElement)?.closest?.('[role="tab"]');
  if (!tab) return;
  e.preventDefault();
  tab.dispatchEvent(new MouseEvent("click", { bubbles: true }));
});


</script>