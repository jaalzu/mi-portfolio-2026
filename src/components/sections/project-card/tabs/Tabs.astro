---
import TabButton from "./TabButton.astro";
import ImageDots from "../image-viewer/ImageDots.astro";

interface TabDef {
  id: string;
  label: string;
  i18nKey?: string;
  iconType: "eye" | "stack" | "circle" | "image";
}

interface Props {
  containerId: string;
  tabs: TabDef[];
  defaultTab?: string;
}

const { containerId, tabs, defaultTab } = Astro.props;
const activeId = defaultTab ?? tabs[0]?.id;
---

<section class="tabs" data-tabs-root>
  <div class="tabs-header">
    <menu role="tablist">
      {tabs.map((tab) => (
        <TabButton
          controls={`${containerId}-${tab.id}`}
          selected={tab.id === activeId}
          i18nKey={tab.i18nKey}
          label={tab.label}
          iconType={tab.iconType}
        />
      ))}
    </menu>
    <div class="img-dots" role="group" aria-label="Imágenes del proyecto" hidden></div>
    <ImageDots />
  </div>
  <div class="tabs-container" data-tabs-container>
    <slot />
  </div>
</section>

<style>
  .tabs { border: none !important; }
  .tabs-container { height: auto; overflow: hidden; transition: height 0.4s cubic-bezier(0.4,0,0.2,1); }
.tabs-container.is-syncing { transition: none !important; }
  .tabs-header { display: flex; align-items: center; justify-content: space-between; gap: 8px; margin: 0 0 4px; }
  menu[role="tablist"] {
    background: transparent !important; border: none !important;
    display: flex !important; gap: 6px; padding: 0 !important;
    margin: 0 !important; flex-wrap: wrap; list-style: none !important;
  }
  .tabs-container { height: auto; overflow: hidden; transition: height 0.4s cubic-bezier(0.4,0,0.2,1); }
</style>

<script>
  import "../scripts/tabs-controller.js";
</script>