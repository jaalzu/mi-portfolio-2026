---
import TabPanel from "../tabs/TabPanel.astro";
import ImageViewer from "../image-viewer/ImageViewer.astro";

interface Props {
  id: string;
  hidden?: boolean;
  projectTitle?: string;
  titleKey?: string;
  images: string[];
  heroImageEn?: string;
  imgId: string;
  fit?: "cover" | "contain";
}

const { id, hidden, projectTitle, titleKey, images, heroImageEn, imgId, fit } = Astro.props;
---

<TabPanel id={id} hidden={hidden}>
  <ImageViewer images={images} heroImageEn={heroImageEn} alt={projectTitle} imgId={imgId} fit={fit} />
  <span class="project-title" data-i18n={titleKey ? `${titleKey}Name` : undefined}>{projectTitle}</span>
</TabPanel>

<style>
  .project-title {
    display: block;
    color: rgb(var(--accent-rgb-alt)) !important;
    font-size: 1.04rem;
    margin-left: .2rem;
    font-weight: 600;
    letter-spacing: 0.45px;
  }
</style>