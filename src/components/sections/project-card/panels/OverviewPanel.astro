---
/**
 * OverviewPanel.astro
 * Contenido del tab "Overview" — la descripción del proyecto.
 */
import TabPanel from "../tabs/TabPanel.astro";

interface Props {
  id: string;
  hidden?: boolean;
  description: string;
  descKey?: string;
}

const { id, hidden, description, descKey } = Astro.props;
---

<TabPanel id={id} hidden={hidden}>
  <p data-i18n={descKey}>{description}</p>
</TabPanel>

<style>
  p {
    font-size: 0.79rem;
    font-weight: 600;
    text-shadow: 2px 2px 1px rgba(0, 0, 0, 0.12);
    line-height: 1.3;
    margin: 0;
  }
</style>
