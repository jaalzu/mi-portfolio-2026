---
import TabPanel from "../tabs/TabPanel.astro";

interface Props {
  id: string;
  hidden?: boolean;
  description?: string;
  descKey?: string;
  origin: string;
  originKey?: string;
}

const { id, hidden, description, descKey, origin, originKey } = Astro.props;
---

<TabPanel id={id} hidden={hidden}>
  <h3 data-i18n="tabOverview">Overview</h3>
  <p data-i18n={descKey}>{description}</p>

  <h3 data-i18n="tabOrigin">Origen</h3>
  <p data-i18n={originKey}>{origin}</p>
</TabPanel>
<style>
h3 {
  margin: 0;
  font-size: 0.81rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.03em;
  color: var(--accent-90);
}

  p {
    font-size: 0.79rem;
    font-weight: 600;
    line-height: 1.5;
  }

  h3 + p {
    margin-top: 3px;
  }

  p + h3 {
    margin-top: 14px;
  }
</style>