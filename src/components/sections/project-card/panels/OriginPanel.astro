---
import TabPanel from "../tabs/TabPanel.astro";

interface Props {
  id: string;
  hidden?: boolean;
  description?: string;
  descKey?: string;
  origin: string;
  originKey?: string;
}

const { id, hidden, description, descKey, origin, originKey } = Astro.props;
---

<TabPanel id={id} hidden={hidden}>
  <p data-i18n={descKey}>{description}</p>
  <p data-i18n={originKey}>{origin}</p>
</TabPanel>

<style>
  p {
    font-size: 0.79rem;
    font-weight: 600;
    line-height: 1.5;
    margin: 0;
  }

  p + p {
    margin-top: 10px;
  }
</style>