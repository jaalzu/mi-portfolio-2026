---
import TabPanel from "../tabs/TabPanel.astro";
import ImageViewer from "../image-viewer/ImageViewer.astro";

interface Props {
  id: string;
  hidden?: boolean;
  images: string[];
  projectTitle: string;
  imgId: string;
  fit?: "cover" | "contain";
}

const { id, hidden, images, projectTitle, imgId, fit } = Astro.props;
---

<TabPanel id={id} hidden={hidden}>
  <ImageViewer images={images} alt={projectTitle} imgId={imgId} fit={fit} />
</TabPanel>