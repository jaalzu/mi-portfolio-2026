---
/**
 * ImagesPanel.astro
 * Contenido del tab "Imágenes" — envuelve el ImageViewer.
 */
import TabPanel from "../tabs/TabPanel.astro";
import ImageViewer from "../image-viewer/ImageViewer.astro";

interface Props {
  id: string;
  hidden?: boolean;
  images: string[];
  projectTitle: string;
  imgId: string; // id único para el <img>, ej: `${id}-img`
}

const { id, hidden, images, projectTitle, imgId } = Astro.props;
---

<TabPanel id={id} hidden={hidden}>
  <ImageViewer images={images} alt={projectTitle} imgId={imgId} />
</TabPanel>
