---
import WinGlass from '../ui/WinGlass.astro';
const { xp = false } = Astro.props;

---

<WinGlass title="Acerca" noControls color="var(--win-info)" {xp}>
  <ul class="info-list">
    <li> Autodidacta (el camino difícil)</li>
    <li> Inglés - Alto</li>
    <li> +3 años de experiencia en desarrollo web</li>
  </ul>
</WinGlass>

<style>
 .info-list {
  margin-block: .4rem;
  padding-left: 24px;
  display: flex;
  flex-direction: column;
  gap: 8px;
  font-size: .980rem;
  font-weight: 400;
}
</style>