---
import WinGlass from '../ui/WinGlass.astro';
const { xp = false } = Astro.props;
---

<WinGlass noControls icon="retro/contact-5.webp"  color="var(--win-info)" {xp}>
  <ul class="info-list">
    <li data-i18n="info1">Aprendizaje autodidacta </li>
    <li data-i18n="info2">Alto nivel de ingles</li>
    <li data-i18n="info3">+3 años de experiencia en desarrollo web</li>
 <li data-i18n="info4">Disfruto colaborar tanto en decisiones técnicas como de producto y UI/UX</li>
  </ul>
</WinGlass>

<style>
  .info-list {
    padding-block: .2rem;
    margin-block: .4rem;
    padding-left: 20px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    font-size: .950rem;
    list-style: disc;
  }

  .info-list li {
    list-style: disc;
  }

  #btn-about-portfolio {
    margin-top: 8px;
  }
</style>