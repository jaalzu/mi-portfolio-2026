---
import WinGlass from '../ui/WinGlass.astro';
const { xp = false } = Astro.props;
---

<WinGlass noControls color="var(--win-info)" {xp}>
  <ul class="info-list">
    <li>Aprendizaje: autodidacta (curioso de nacimiento)</li>
    <li>Inglés - Alto</li>
    <li>+3 años de experiencia en desarrollo web</li>
  </ul>
</WinGlass>

<style>
  .info-list {
    padding-block: .2rem;
    margin-block: .4rem;
    padding-left: 20px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    font-size: .950rem;
    list-style: disc;
  }

  .info-list li {
    list-style: disc;
  }

  #btn-about-portfolio {
    margin-top: 8px;
  }
</style>