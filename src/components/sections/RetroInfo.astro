---
import WinGlass from '../ui/WinGlass.astro';
const { xp = false } = Astro.props;
---

<WinGlass noControls icon="retro/contact-5.webp"  color="var(--win-info)" {xp}>
  <ul class="info-list">
    <li data-i18n="info1"></li>
    <li data-i18n="info2"></li>
    <li data-i18n="info3"></li>
 <li data-i18n="info4"></li>
  </ul>
</WinGlass>

<style>
  .info-list {
    margin-block: .8rem;
    padding-left: 20px;
    display: flex;
    flex-direction: column;
    gap: 6px;
    font-size: .9rem;
  }

  .info-list li {
    list-style: disc;
  }

</style>