---
import WinGlass from '../ui/WinGlass.astro';

const techs = [
  { name: "HTML5",      icon: "/icons/tech/html5.svg" },
  { name: "CSS3",       icon: "/icons/tech/css.svg" },
  { name: "JavaScript", icon: "/icons/tech/javascript.svg" },
  { name: "Git",        icon: "/icons/tech/git.svg" },
  { name: "Figma",      icon: "/icons/tech/figma.svg" },
  { name: "React",      icon: "/icons/tech/react_light.svg" },
  { name: "TypeScript", icon: "/icons/tech/typescript.svg" },
  { name: "Tailwind",   icon: "/icons/tech/tailwindcss.svg" },
  { name: "Next.js",    icon: "/icons/tech/nextjs_dark.svg" },
  { name: "Astro",      icon: "/icons/tech/astro-icon-dark.svg" },
  { name: "PostgreSQL",        icon: "/icons/tech/postgresql.svg" },
  { name: "Supabase",   icon: "/icons/tech/supabase.svg" },
  { name: "Zod",        icon: "/icons/tech/zod.svg" },
  { name: "Zustand",        icon: "/icons/tech/zustand-original.svg" },
  { name: "TanStack Query",        icon: "/icons/tech/reactquery.svg" },
  { name: "Playwright",        icon: "/icons/tech/playwright.svg" },
  { name: "Vitest",      icon: "/icons/tech/vitest.svg" },
  { name: "Claude",     icon: "/icons/tech/claude.svg" },
];
---
<WinGlass noTitlebar noControls icon="retro/tech-5.webp" color="var(--win-tech)">
    <h2 class="tech-title" data-i18n="techTitle">Tech Stack</h2>
    <div class="tech-grid">
  {techs.map(tech => (
  <div class="tech-item">
    <img loading="lazy" src={tech.icon} alt={tech.name}  />
    <span class="tech-name">{tech.name}</span>
  </div>
))}
  </div>
</WinGlass>

<style>
.tech-title {
  margin: 0;
  text-align: center;
  margin-top: .4rem;
  font-size: 1.2rem;
  font-weight: 600;
  color: var(--accent-solid);
}

.tech-grid {
  display: grid;
  grid-template-columns: repeat(6, 1fr);
  padding: .7rem;
  margin-block: .5rem;
  gap: 37px 5px;
}

.tech-item {
  display: flex;
  flex-direction: column;
  font-weight: 600;
  align-items: center;
  font-size: 0.820rem;
  text-align: center;
  cursor: pointer;
  height: 54px;
  position: relative;
  justify-content: center;
}

.tech-item img {
  width: 38px;
  height: 38px;
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  animation: none;
}

.tech-item:hover img {
  animation: iconUp 0.45s cubic-bezier(0.4, 0, 0.2, 1) forwards;
}

.tech-item:not(:hover) img {
  animation: iconDown 0.4s cubic-bezier(0.4, 0, 0.2, 1) forwards;
}

@keyframes iconUp {
  from {
    transform: translateY(-50%) scale(1);
  }
  to {
    transform: translateY(-80%) scale(0.78);
  }
}

@keyframes iconDown {
  from {
    transform: translateY(-80%) scale(0.78);
  }
  to {
    transform: translateY(-50%) scale(1);
  }
}

.tech-name {
  position: absolute;
  bottom: 2px;
  left: 0;
  right: 0;
  opacity: 0;
  transform: translateY(5px);
  transition:
    opacity 0.4s cubic-bezier(0.4, 0, 0.2, 1) 0.05s,
    transform 0.4s cubic-bezier(0.4, 0, 0.2, 1) 0.05s;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  font-size: 0.72rem;
}

.tech-item:hover .tech-name {
  opacity: 1;
  transform: translateY(0);
}

@media (max-width: 1300px) {
  .tech-grid {
    grid-template-columns: repeat(6, 1fr);
    gap: 29px 11px;
    padding: 0.2rem;
  }

  .tech-item {
    font-size: 0.750rem;
    gap: 5px;
  }

}

@media (max-width: 900px) {
  .tech-grid { 
    grid-template-columns: repeat(4, 1fr); 
    gap: 23px 13px;
  }
   .tech-item img {
    width:36px;
    height:36px;
  }
}

@media (max-width: 500px) {
  .tech-grid { 
    grid-template-columns: repeat(3, 1fr);
  }
  .tech-item img {
    width: 32px;
    height: 32px;
  }
}
</style>