---
import WinGlass from '../ui/WinGlass.astro';
const { xp = false } = Astro.props;
---

<WinGlass title="Javier" noControls noPadding icon="retro/jpg-8.webp" color="var(--win-picture)" xp={xp}>
  <img src="me/me13.webp" alt="Foto" class="profile-img" />
</WinGlass>

<style>
  .profile-img {
    width: 100%;
    height: 140px;
    object-fit: cover;
    display: block;
  }





</style>
