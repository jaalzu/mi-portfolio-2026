---
import WinGlass from '../ui/WinGlass.astro';
const { xp = false } = Astro.props;
---

<WinGlass title="yo.jpg" noControls noPadding icon="retro/jpg-8.webp" color="var(--win-picture)" xp={xp} >
  <img src="/src/assets/catcat.webp" alt="Foto" class="profile-img" />
  <div slot="status-bar" class="status-bar">
  </div>
</WinGlass>

<style>
  .profile-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

</style>
