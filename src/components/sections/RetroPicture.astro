---
import WinGlass from '../ui/WinGlass.astro';
const { xp = false } = Astro.props;
---

<WinGlass title="Javier Alzú" noControls noPadding icon="retro/jpg-8.webp" color="var(--win-picture)" xp={xp}>
  <img src="me/me13.webp" alt="Foto" class="profile-img" />
<div slot="status-bar" class="status-bar" style="display: flex; align-items: center;">
  <p class="status-bar-field" style="text-align: center;" data-i18n="picAge">25 años</p>
  <p class="status-bar-field" style="text-align: center;" data-i18n="picCountry">Argentina</p>
</div>
</WinGlass>

<style>
  .profile-img {
    width: 100%;
    height: 170px;
    object-fit: cover;
    display: block;
  }

  p{
    font-size: .9rem;
    font-weight: 600;
  }



</style>
