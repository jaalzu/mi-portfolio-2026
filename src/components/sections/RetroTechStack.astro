---
import WinGlass from '../ui/WinGlass.astro';
const techs = [
  { name: "HTML5",      icon: "/icons/html5.svg" },
  { name: "CSS3",       icon: "/icons/css.svg" },
  { name: "JavaScript", icon: "/icons/javascript.svg" },
  { name: "React",      icon: "/icons/react_light.svg" },
  { name: "TypeScript", icon: "/icons/typescript.svg" },
  { name: "Next.js",    icon: "/icons/nextjs_dark.svg" },
  { name: "Tailwind",   icon: "/icons/tailwindcss.svg" },
  { name: "Astro",      icon: "/icons/astro-icon-dark.svg" },
  { name: "Supabase",   icon: "/icons/supabase.svg" },
  { name: "Git",        icon: "/icons/git.svg" },
  { name: "Figma",      icon: "/icons/figma.svg" },
  { name: "Claude",     icon: "/icons/claude.svg" },
  { name: "Sentry",     icon: "/icons/sentry.svg" },
  { name: "Vite",       icon: "/icons/vite.svg" },
  { name: "Zod",        icon: "/icons/zod.svg" },
  { name: "TanStack Query",        icon: "/icons/reactquery.svg" },
  { name: "Postman",        icon: "/icons/postman.svg" },
  { name: "Chakra-UI",        icon: "/icons/chakra-ui.svg" },
];
---

<WinGlass title="Tech Stack" noControls transparent>
  <div class="tech-grid">
    {techs.map(tech => (
  <div class="tech-item">
    <img src={tech.icon} alt={tech.name} width="30" height="30" />
    <span>{tech.name}</span>
  </div>
))}
  </div>
</WinGlass>

<style>
.tech-grid {
  display: grid;
  grid-template-columns: repeat(6, 1fr);
  padding: .5rem;
  margin-block: .4rem;
  gap: 15px 18px;
}
  .tech-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    font-size: .8rem;
    text-align: center;
    color: #000000;
  }

  @media (max-width: 900px) {
    .tech-grid { grid-template-columns: repeat(4, 1fr); 
                gap: 20px 25px;
    }
  }

  @media (max-width: 500px) {
    .tech-grid { grid-template-columns: repeat(3, 1fr);
               gap: 15px 25px;
    }
  }
</style>