---
import WinGlass from '../ui/WinGlass.astro';
const { xp = false } = Astro.props;
---
<WinGlass 
  title="Sobre mí" 
  titleKey="winAbout" 
  icon="retro/me-7.webp" 
  color="var(--win-about)" 
  noControls
  {xp}
>
  <div class="about-body">
    <div class="about-text">
      <h1>
        <span class="rol" data-i18n="aboutRole"></span>
        <span data-i18n="aboutText"></span>
        <br>
        <span data-i18n="aboutText2"></span>
        <br />
        <span data-i18n="aboutText3"></span>
      </h1>
    </div>

    <div class="contact-links">
      <div
        class="icon-btn tab-btn github-btn"
        role="button"
        tabindex="0"
        onclick="window.open('https://github.com/jaalzu', '_blank')"
        onkeydown="if(event.key==='Enter'||event.key===' '){event.preventDefault();this.click();}"
      >
<span class="tab-icon github-icon">
  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256">
    <rect width="256" height="256" fill="none"/>
    <path class="gh-head" d="M119.83,56A52,52,0,0,0,76,32a51.92,51.92,0,0,0-3.49,44.7A49.28,49.28,0,0,0,64,104v8a48,48,0,0,0,48,48h48a48,48,0,0,0,48-48v-8a49.28,49.28,0,0,0-8.51-27.3A51.92,51.92,0,0,0,196,32a52,52,0,0,0-43.83,24Z" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="16"/>
    <path class="gh-legs" d="M104,232V192a32,32,0,0,1,32-32h0a32,32,0,0,1,32,32v40" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="16"/>
    <path class="gh-tail-base" d="M104,208 H72 A32,32 0 0 1 40,176" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="16"/>
    <path class="gh-tail-tip" d="M40,176 A32,32 0 0 0 8,144" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="16"/>
  </svg>
</span>
      </div>

    <div
  class="icon-btn tab-btn linkedin-btn"
  role="button"
  tabindex="0"
  onclick="window.open('https://www.linkedin.com/in/javier-alz%C3%BA-332ab2261/', '_blank')"
  onkeydown="if(event.key==='Enter'||event.key===' '){event.preventDefault();this.click();}"
>
  <span class="tab-icon linkedin-icon">
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256">
      <defs>
        <clipPath id="li-round-clip">
          <rect x="24" y="24" width="208" height="208" rx="16"/>
        </clipPath>
      </defs>

      <!-- marco: el cuadrado con esquina redondeada, hueco -->
      <path class="li-frame" d="M216,24H40A16,16,0,0,0,24,40V216a16,16,0,0,0,16,16H216a16,16,0,0,0,16-16V40A16,16,0,0,0,216,24Zm0,192H40V40H216V216Z" fill="currentColor"/>

      <!-- relleno blanco: crece desde abajo, recortado con esquinas redondas -->
      <rect class="li-fill" x="24" y="232" width="208" height="0" fill="#fff" clip-path="url(#li-round-clip)"/>

      <!-- letras "in": siempre arriba de todo -->
      <path class="li-letters" d="M96,112v64a8,8,0,0,1-16,0V112a8,8,0,0,1,16,0Zm88,28v36a8,8,0,0,1-16,0V140a20,20,0,0,0-40,0v36a8,8,0,0,1-16,0V112a8,8,0,0,1,15.79-1.78A36,36,0,0,1,184,140ZM100,84A12,12,0,1,1,88,72,12,12,0,0,1,100,84Z" fill="currentColor"/>
    </svg>
  </span>
</div>
    </div>
  </div>
</WinGlass>

<style>
  .about-body {
    display: flex;
    flex-direction: column;
  }
  .icon-btn {
    color: white;
  }
  .about-text h1 {
    margin: 6px 5px 0px 8px;
    font-size: 1.1rem;
    font-weight: 600;
    text-shadow: 2px 2px 1px rgba(0, 0, 0, 0.13);
    line-height: 1.3;
  }
  @media (max-width: 500px) {
    .about-text h1 { font-size: 1rem; }
  }
  .contact-links {
    display: flex;
    justify-content: flex-end;
    align-items: center;
    gap: 8px;
  }
  .github-icon svg {
    overflow: visible;
  }
</style>

<script>
import gsap from "gsap";
function initGithubTail() {
  // Busca TODOS los botones de GitHub en la página que todavía no fueron inicializados.
  // El :not([data-gsap-ready]) evita que se re-registre el evento dos veces
  // si esta función se llama de nuevo (por ejemplo, al navegar con Astro View Transitions).
  document.querySelectorAll<HTMLElement>('.github-btn:not([data-gsap-ready])').forEach(btn => {

    // Marca este botón como "ya procesado" para que la próxima vez no se duplique el listener.
    btn.setAttribute("data-gsap-ready", "1");

    const svg = btn.querySelector("svg");
    // Selecciona SOLO la puntita de la cola (el segundo arco, el que se mueve).
    // Si algún día separás más partes del ícono, acá agregarías más selectores así.
    const tip = btn.querySelector<SVGPathElement>(".gh-tail-tip");

    // Guard clause: si por algo no existe el SVG o la punta, no sigue (evita errores en consola).
    if (!svg || !tip) return;

    // ── PIVOTE ──────────────────────────────────────────────
    // Define desde qué punto rota la punta. Tiene que ser el punto EXACTO
    // donde este path arranca (mirá el "d" del path: empieza en M40,176),
    // así la rotación no despega la punta de la base — quedan siempre unidas.
    // 🔧 TOCAR ACÁ SI: la unión se ve "flotando" o desalineada.
    //    Requiere mirar el 'd' del path .gh-tail-tip y usar su primer punto (M x,y).
    gsap.set(tip, { transformOrigin: "40px 176px" });

    // ── LA ANIMACIÓN (el "wag") ─────────────────────────────
    // Es una timeline de GSAP: una cadena de pasos que se ejecutan en orden.
    // paused: true → no arranca sola, se dispara manualmente con .restart() más abajo.
    const wag = gsap.timeline({ paused: true })

      // Paso 1: rota -6° (hacia un lado) en 0.5 segundos, con curva suave (sine.inOut)
      // 🔧 TOCAR: el número (-6) = qué tan lejos se mueve en este paso.
      //           duration (0.5) = cuánto tarda este paso puntual.
      .to(tip, { rotate: 6, duration: 0.5, ease: "sine.inOut" })

      // Paso 2: rota hacia el lado contrario (+6°), un poco más lento (0.6s)
      .to(tip, { rotate: 6,  duration: 0.6, ease: "sine.inOut" })

      // Paso 3: vuelve parcialmente (-3°), simulando que va perdiendo energía
      .to(tip, { rotate: -3, duration: 0.5, ease: "sine.inOut" })

      // Paso 4: último asentamiento, casi en el punto de reposo (2° en vez de 0°)
      // Nota: termina en 2°, no en 0° — así el reposo final queda con una leve
      // curva residual en vez de volver 100% a la posición original.
      // 🔧 TOCAR: si querés que vuelva EXACTO al origen, cambiá este 2 por 0.
      .to(tip, { rotate: 0,  duration: 0.6, ease: "sine.inOut" });

    // ── DISPARADOR ───────────────────────────────────────────
    // Cuando el mouse entra al botón, reinicia y reproduce la timeline desde cero.
    // .restart() en vez de .play() es importante: si pasás el mouse rápido
    // varias veces, cada hover arranca la secuencia completa de nuevo,
    // no la continúa a mitad de camino.
    btn.addEventListener("mouseenter", () => wag.restart());
  });
}


function initLinkedinFill() {
  document.querySelectorAll('.linkedin-btn:not([data-gsap-ready])').forEach(btn => {
    btn.setAttribute("data-gsap-ready", "1");
    const fill    = btn.querySelector('.li-fill');
    const letters = btn.querySelector('.li-letters');
    if (!fill || !letters) return;

    const tl = gsap.timeline({ paused: true })
      .to(fill, {
        attr: { y: 24, height: 208 },
        duration: 0.55,
        ease: "power2.inOut"
      }, 0)
      .to(letters, {
        fill: "#0a0a0a",
        duration: 0.3,
        ease: "power1.out"
      }, 0.15); // arranca un poco después, cuando el relleno ya subió parte del camino

    btn.addEventListener("mouseenter", () => tl.play());
    btn.addEventListener("mouseleave", () => tl.reverse());
    btn.addEventListener("focus",      () => tl.play());
    btn.addEventListener("blur",       () => tl.reverse());
  });
}

initGithubTail();
initLinkedinFill();
document.addEventListener("astro:page-load", initGithubTail);
</script>