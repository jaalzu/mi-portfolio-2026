---
import WinGlass from '../ui/WinGlass.astro';
---

<WinGlass title="Sobre mí">
  <div class="about-body">
    <div class="win picture-win">
      <WinGlass noControls noPadding>
        <img src="/src/assets/catcat.webp" alt="Foto" class="profile-img" />
        <div slot="status-bar" class="status-bar"></div>
      </WinGlass>
    </div>
    <div class="about-text">
      <h2>Hola! Soy Javier A.</h2>
      <p class="subtitle">
          <span class="text-content">25 años · Chaco, Argentina</span>
          <img src="/ar.svg" alt="Argentina" class="flag" />
        </span>
      </p>
      <p>Desarrollador Frontend con experiencia en el diseño, desarrollo y mejora de aplicaciones web. Transformo requisitos complejos en experiencias de usuario destacadas, abordando cada proyecto con entusiasmo y compromiso.</p>
    </div>
  </div>
</WinGlass>



<style>
  .about-body {
    display: flex;
    gap: 26px;
    align-items: flex-start;
  }

  .picture-win .profile-img {
    width: 110px;
    height: 110px;
    object-fit: cover;
    display: block;
  }

  .about-text h2 { margin: 0 0 -4px; font-size: 1.4rem; }
  .about-text p  { margin: 0 0 16px; font-size: 1.4rem; font-weight: bold; 
    line-height: 1.3; }
.about-text span{
    font-size: .950rem;
}
  .decrypt-text {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    cursor: pointer;
  }
  .flag { width: 16px; height: auto; }

  @media (max-width: 500px) {
    .about-body { flex-direction: column; }
  }
</style>