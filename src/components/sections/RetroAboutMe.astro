---
import WinGlass from '../ui/WinGlass.astro';
import AsciiPhoto from '../ui/AsciiPhoto.astro';
import GithubButton from '../ui/GithubButton.astro';
import LinkedinButton from '../ui/LinkedinButton.astro';

const { xp = false } = Astro.props;
---


<WinGlass
  title="Sobre mí"
  titleKey="winAbout"
  icon="retro/me-7.webp"
  color="var(--win-about)"
  noControls
  {xp}
>
  <div class="about-body">
    <div class="photo-column">
      <AsciiPhoto width="220px" height="200px" />
      <div class="contact-links">
        <GithubButton />
        <LinkedinButton />
      </div>
    </div>

    <div class="about-content">
      <div class="about-text">
        <div class="slider" id="about-slider">
          <div class="slider-track" id="about-track">
            <div class="slide">
              <h1>
                <span class="rol" data-i18n="aboutRole"></span>
                <span data-i18n="aboutText"></span>
                <br />
                <span data-i18n="aboutText2"></span>
                <br />
                <span data-i18n="aboutText3"></span>
              </h1>
            </div>

            <div class="slide">
              <h1>
                <span>Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod tempor incididunt ut labore et dolore magna aliqua.</span>
              </h1>
            </div>

            <div class="slide">
              <h1>
                <span>Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip ex ea commodo consequat.</span>
              </h1>
            </div>
          </div>
        </div>

        <div class="slider-nav">
          <button class="nav-arrow prev" id="about-prev" aria-label="Anterior">
            &#8592;
          </button>

          <span class="slider-counter" id="about-counter"></span>

          <button class="nav-arrow next" id="about-next" aria-label="Siguiente">
            &#8594;
          </button>
        </div>
      </div>
    </div>
  </div>
</WinGlass>

<style>
  .about-body {
    display: flex;
    flex-direction: row;
    align-items: stretch;
    gap: 12px;
  }

  .photo-column {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
  }

 .contact-links {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 8px;
    margin-top: 16px;
  }

  .about-content {
    display: flex;
    flex-direction: column;
    justify-content: center;
    flex: 1;
    min-width: 0;
  }

  .about-text h1 {
    margin: 6px 5px 0px 0px;
    font-size: 1.1rem;
    font-weight: 600;
    text-shadow: 2px 2px 1px rgba(0, 0, 0, 0.13);
    line-height: 1.3;
  }

  .slider {
    position: relative;
    overflow: hidden;
    min-height: 90px;
  }

   

 
  .slider-track {
    display: flex;
    width: 300%;
    transition: transform 0.45s cubic-bezier(0.65, 0, 0.35, 1);
    will-change: transform;
  }

  .slide {
    flex: 0 0 33.3333%;
    min-width: 0;
  }

  .slide h1 {
    margin: 6px 5px 0px 0px;
  }

  .slider-nav {
    display: grid;
    grid-template-columns: 24px 1fr 24px;
    align-items: center;
    margin-top: 4px;
  }

  .about-text .slider-nav .nav-arrow {
    background: none;
    border: none;
    cursor: pointer;
    font-size: 1.1rem;
    line-height: 1;
    padding: 2px 6px;
    color: #ffffff;
    opacity: 0;
    pointer-events: none;
    transform: translateX(0);
    transition: opacity 0.18s ease, color 0.15s ease;
  }

  .about-text .slider-nav .nav-arrow.prev {
    justify-self: start;
    transform: translateX(-4px);
  }

  .about-text .slider-nav .nav-arrow.next {
    justify-self: end;
    transform: translateX(4px);
  }

  .about-text .slider-nav .nav-arrow.visible {
    opacity: 0.85;
    pointer-events: auto;
    transform: translateX(0);
    transition: opacity 0.18s ease, transform 0.18s ease, color 0.15s ease;
  }

  .about-text .slider-nav .nav-arrow.visible:hover {
    opacity: 1;
  }

    .about-text .slider-nav .slider-counter {
    grid-column: 2;
    justify-self: center;
    font-size: 0.85rem;
    font-weight: 600;
    color: rgba(21, 255, 0, 0.4);
    min-width: 28px;
    text-align: center;
    display: inline-block;
  }

  .counter-digit {
    position: absolute;
    inset: 0;
    display: block;
    color: rgba(21, 255, 0, 0.4);
    transition: transform 0.26s cubic-bezier(0.65, 0, 0.35, 1), opacity 0.26s ease;
  }

  .counter-digit.enter {
    transform: translateY(-100%);
    opacity: 0;
  }

  .counter-digit.exit-active {
    transform: translateY(100%);
    opacity: 0;
  }

  @media (max-width: 500px) {
    .about-body {
      flex-direction: column;
      align-items: center;
    }
    .about-text h1 {
      font-size: 1rem;
    }
  }
</style>
<script>
  function initAboutSlider() {
    const track = document.getElementById('about-track');
    if (!track) return;

    const slides = Array.from(track.children);
    const prevBtn = document.getElementById('about-prev');
    const nextBtn = document.getElementById('about-next');
    const counterEl = document.getElementById('about-counter');
    let current = 0;

    function updateArrows() {
      prevBtn.classList.toggle('visible', current > 0);
      nextBtn.classList.toggle('visible', current < slides.length - 1);
    }

    function updateCounter(animate) {
      counterEl.textContent = `${current + 1}/${slides.length}`;
      if (!animate) return;

      counterEl.classList.remove('fade');
      void counterEl.offsetWidth; // reinicia la animación
      counterEl.classList.add('fade');
    }

    function render(animate = true) {
      track.style.transform = `translateX(-${current * (100 / slides.length)}%)`;
      updateCounter(animate);
      updateArrows();
    }

    prevBtn.addEventListener('click', () => {
      if (current > 0) {
        current--;
        render();
      }
    });

    nextBtn.addEventListener('click', () => {
      if (current < slides.length - 1) {
        current++;
        render();
      }
    });

    track.style.transition = 'none';
    updateArrows();
    render(false);
    requestAnimationFrame(() => {
      track.style.transition = '';
    });
  }

  document.addEventListener('astro:page-load', initAboutSlider);
  initAboutSlider();
</script>