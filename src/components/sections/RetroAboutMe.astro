---
import WinGlass from '../ui/WinGlass.astro';
const { xp = false } = Astro.props;
---
<WinGlass 
  title="Sobre mí" 
  titleKey="winAbout" 
  icon="retro/me-7.webp" 
  color="var(--win-about)" 
  noControls
  {xp}
>
  <div class="about-body">
    <div class="about-text">
  <h1>
  <span class="rol" data-i18n="aboutRole"></span>

  <span data-i18n="aboutText"></span>
  <br>
  <span data-i18n="aboutText2"></span>
  <br />
  <span data-i18n="aboutText3"></span>
</h1>
    </div>

<div class="contact-links">
  <div
    class="icon-btn tab-btn github-btn"
    role="button"
    tabindex="0"
    onclick="window.open('https://github.com/jaalzu', '_blank')"
    onkeydown="if(event.key==='Enter'||event.key===' '){event.preventDefault();this.click();}"
  >
    <svg class="adaptive-icon" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 256 256">
      <path d="M208.31,75.68A59.78,59.78,0,0,0,202.93,28,8,8,0,0,0,196,24a59.75,59.75,0,0,0-48,24H124A59.75,59.75,0,0,0,76,24a8,8,0,0,0-6.93,4,59.78,59.78,0,0,0-5.38,47.68A58.14,58.14,0,0,0,56,104v8a56.06,56.06,0,0,0,48.44,55.47A39.8,39.8,0,0,0,96,192v8H72a24,24,0,0,1-24-24A40,40,0,0,0,8,136a8,8,0,0,0,0,16,24,24,0,0,1,24,24,40,40,0,0,0,40,40H96v16a8,8,0,0,0,16,0V192a24,24,0,0,1,48,0v40a8,8,0,0,0,16,0V192a39.8,39.8,0,0,0-8.44-24.53A56.06,56.06,0,0,0,216,112v-8A58.14,58.14,0,0,0,208.31,75.68ZM200,112a40,40,0,0,1-40,40H112a40,40,0,0,1-40-40v-8a41.74,41.74,0,0,1,6.9-22.48A8,8,0,0,0,80,73.83a43.81,43.81,0,0,1,.79-33.58,43.88,43.88,0,0,1,32.32,20.06A8,8,0,0,0,119.82,64h32.35a8,8,0,0,0,6.74-3.69,43.87,43.87,0,0,1,32.32-20.06A43.81,43.81,0,0,1,192,73.83a8.09,8.09,0,0,0,1,7.65A41.72,41.72,0,0,1,200,104Z" fill="currentColor"/>
    </svg>
  </div>

  <div
    class="icon-btn tab-btn linkedin-btn"
    role="button"
    tabindex="0"
    onclick="window.open('https://www.linkedin.com/in/javier-alz%C3%BA-332ab2261/', '_blank')"
    onkeydown="if(event.key==='Enter'||event.key===' '){event.preventDefault();this.click();}"
  >
    <svg class="adaptive-icon" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 256 256">
      <path d="M216,24H40A16,16,0,0,0,24,40V216a16,16,0,0,0,16,16H216a16,16,0,0,0,16-16V40A16,16,0,0,0,216,24Zm0,192H40V40H216V216ZM96,112v64a8,8,0,0,1-16,0V112a8,8,0,0,1,16,0Zm88,28v36a8,8,0,0,1-16,0V140a20,20,0,0,0-40,0v36a8,8,0,0,1-16,0V112a8,8,0,0,1,15.79-1.78A36,36,0,0,1,184,140ZM100,84A12,12,0,1,1,88,72,12,12,0,0,1,100,84Z" fill="currentColor"/>
    </svg>
  </div>
</div>
  </div>
</WinGlass>
<style>
  .about-body {
    display: flex;
    flex-direction: column;
  }

  .about-text h1 {
    margin: 6px 5px 0px 8px;
    font-size: 1.1rem;
    font-weight: 600;
    text-shadow: 2px 2px 1px rgba(0, 0, 0, 0.13);
    line-height: 1.3;
  }

  @media (max-width: 500px) {
    .about-text h1 {
      font-size: 1rem;
    }
  }

  .contact-links {
    display: flex;
    justify-content: flex-end;
    align-items: center;
    margin-top: 15px;
    gap: 8px;
  }
</style>