---
import WinGlass from '../ui/WinGlass.astro';
---

<WinGlass title="Sobre mí">
  <div class="about-body">
    <div class="win picture-win">
      <WinGlass noControls noPadding>
        <img src="/src/assets/catcat.webp" alt="Foto" class="profile-img" />
        <div slot="status-bar" class="status-bar"></div>
      </WinGlass>
    </div>
    <div class="about-text">
      <h2>Hola! Soy Javier A.</h2>
      <p class="subtitle">
        <span
          id="decrypt-text"
          class="decrypt-text"
          data-original="25 años · Chaco, Argentina"
          data-hover="Gracias por pasarte. No te olvides de ver mis proyectos!"
        >
          <span class="text-content">25 años · Chaco, Argentina</span>
          <img src="/ar.svg" alt="Argentina" class="flag" />
        </span>
      </p>
      <p>Desarrollador Frontend con experiencia en el diseño, desarrollo y mejora de aplicaciones web. Transformo requisitos complejos en experiencias de usuario destacadas, abordando cada proyecto con entusiasmo y compromiso.</p>
    </div>
  </div>
</WinGlass>

<script is:inline>
  (function() {
    const el = document.getElementById('decrypt-text');
    if (!el) return;
    const textSpan = el.querySelector('.text-content');
    const flag = el.querySelector('.flag');
    const chars = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789!@#$%^&*";
    let interval = null;

    const animate = (targetText, isHovering) => {
      let iteration = 0;
      clearInterval(interval);
      if (flag) {
        flag.style.opacity = isHovering ? "0" : "1";
        flag.style.display = isHovering ? "none" : "inline-block";
      }
      interval = setInterval(() => {
        if (textSpan) {
          textSpan.innerText = targetText.split("")
            .map((char, index) => {
              if (index < iteration) return targetText[index];
              return chars[Math.floor(Math.random() * chars.length)];
            }).join("");
        }
        if (iteration >= targetText.length) clearInterval(interval);
        iteration += 1;
      }, 18);
    };

    el.addEventListener('mouseenter', () => animate(el.dataset.hover, true));
    el.addEventListener('mouseleave', () => animate(el.dataset.original, false));
  })();
</script>

<style>
  .about-body {
    display: flex;
    gap: 16px;
    align-items: flex-start;
  }

  .picture-win .profile-img {
    width: 100px;
    height: 100px;
    object-fit: cover;
    display: block;
  }

  .about-text h2 { margin: 0 0 4px; font-size: 1.1rem; }
  .about-text p  { margin: 0 0 8px; font-size: 1.2rem; font-weight: bold; line-height: 1.3; }

  .decrypt-text {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    cursor: pointer;
  }
  .flag { width: 16px; height: auto; }

  @media (max-width: 500px) {
    .about-body { flex-direction: column; }
  }
</style>