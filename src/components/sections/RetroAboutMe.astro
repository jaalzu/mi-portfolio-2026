---
import WinGlass from '../ui/WinGlass.astro';
const { xp = false } = Astro.props;

---
<WinGlass 
  title="Sobre mí" 
  titleKey="winAbout" 
  icon="retro/me-7.webp" 
  color="var(--win-about)" 
  {xp}
>
  <div class="about-body">
    <div class="about-text">
    <h1>
  <span style="color: red;" data-i18n="aboutRole">Desarrollador Frontend</span>
  <span data-i18n="aboutText"> con experiencia en el diseño, desarrollo, mantenimiento y mejora de aplicaciones web.</span>
  <span data-i18n="aboutText2">Transformo requisitos complejos en experiencias de usuario destacadas, abordando cada proyecto con entusiasmo y compromiso.</span>
</h1>
    </div>
  </div>
</WinGlass>



<style>
  .about-body {
    display: flex;
    padding-left: .6rem;
  }

  .about-text h1  { margin: 0 0 16px; font-size: 1.4rem; font-weight: 600; 
    line-height: 1.3; }

  @media (max-width: 500px) {
    .about-body {
    padding-left: .2rem;
  }
    .about-text h1{
      font-size: 1.1rem;
      padding: .2rem;
    }
  }
</style>