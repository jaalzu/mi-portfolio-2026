---
import WinGlass from '../ui/WinGlass.astro';
const { xp = false } = Astro.props;

---
<WinGlass 
  title="Sobre mí" 
  titleKey="winAbout" 
  icon="retro/me-7.webp" 
  color="var(--win-about)" 
  noControls
  {xp}
>
  <div class="about-body">
    <div class="about-text">
  <h1>
  <span class="rol" data-i18n="aboutRole"></span>

  <span data-i18n="aboutText"></span>
  <br>
  <span data-i18n="aboutText2"></span>
  <br />
  <span data-i18n="aboutText3"></span>
</h1>
    </div>

  <div class="contact-links">
<button class="icon-btn" onclick="window.open('https://github.com/jaalzu', '_blank')">
  <img src="/moreicons/github.svg" alt="GitHub" width="18" height="18" />
  GitHub
</button>

<button class="icon-btn" onclick="window.open('https://www.linkedin.com/in/javier-alz%C3%BA-332ab2261/', '_blank')">
  <img src="/moreicons/linkedin.svg" alt="LinkedIn" width="18" height="18" />
  LinkedIn
</button>
</div>
  </div>
</WinGlass>



<style>
  .about-body {
    display: flex;
    flex-direction: column;
  }


button{
  background: transparent !important;
  padding: .4rem .7rem !important;
}
  .about-text h1  {
     margin: 6px 5px 0px 8px; 
    font-size: 1.1rem; 
    font-weight: 600;
  text-shadow: 2px 2px 1px rgba(0, 0, 0, 0.130);

    line-height: 1.3; }

  @media (max-width: 500px) {
    .about-body {
  }
    .about-text h1{
      font-size: 1rem;
    }
  }

  

  button{
    display: flex;
    align-items: center;
    justify-content: center;
    gap: .4rem;
  }
  
.text-link{
  color: rgb(7, 108, 231);
  font-weight: 500;
}

  .contact-links {
    display: flex;
    justify-content: flex-end;
    align-items: center;
    margin-top: 15px;
    gap: 8px;
  }




</style>