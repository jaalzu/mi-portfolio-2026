---
import WinGlass from '../ui/WinGlass.astro';
const { xp = false } = Astro.props;

---
<WinGlass title="Sobre mí" color="var(--win-about)" {xp}>
  <div class="about-body">
    <div class="about-text">
      <h2>Hola! Soy Javier A.</h2>
      <p class="subtitle">
          <span class="text-content">25 años - Chaco, Argentina</span>
          <img src="/ar.svg" alt="Argentina" class="flag" />
        </span>
      </p>
      <p>Desarrollador Frontend con experiencia en el diseño, desarrollo y mejora de aplicaciones web. Transformo requisitos complejos en experiencias de usuario destacadas, abordando cada proyecto con entusiasmo y compromiso.</p>
    </div>
  </div>
</WinGlass>



<style>
  .about-body {
    display: flex;
    gap: 26px;
    align-items: flex-start;
    padding: .5rem;
  }

  .picture-win .profile-img {
    width: 110px;
    height: 110px;
    object-fit: cover;
    display: block;
  }


  .about-text h2 { margin: 0 0 -4px; font-size: 1.3rem; font-weight: 600}
  .about-text p  { margin: 0 0 16px; font-size: 1.3rem; font-weight: 700; 
    line-height: 1.250; }
.about-text span{
    font-weight: 400;
    font-size: .950rem;
}

  .flag { width: 18px; height: auto; }

  @media (max-width: 500px) {
    .about-body { flex-direction: column; }
  }
</style>