---
import { translations } from '../lib/translations';
---

<div class="scroll-bg" id="scroll-bg">
  <div class="bg-layer" id="bg-day" style="background-image: url('/bg/city.webp')"></div>
  <div class="bg-layer" id="bg-rain" style="background-image: url('/bg/rain.webp'); opacity: 0"></div>
  <div class="bg-layer" id="bg-sunset" style="background-image: url('/bg/sunset.webp'); opacity: 0"></div>
  <div class="bg-layer" id="bg-night" style="background-image: url('/bg/night.webp'); opacity: 0"></div>
  <div class="bg-layer" id="bg-moon" style="background-image: url('/bg/e2.webp'); opacity: 0"></div>
  <canvas id="bg-rain-canvas" aria-hidden="true"></canvas>
</div>

<style>
  .scroll-bg {
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }

  .bg-layer {
    position: absolute;
    inset: -1px;
    background-size: cover;
    background-position:center;
    background-repeat: no-repeat;
    will-change: opacity, transform;
    isolation: isolate;
  }

  #bg-rain-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    opacity: 0;
  }
</style>

<script is:inline define:vars={{ translations }}>
document.addEventListener('DOMContentLoaded', () => {

const bgSunset = document.getElementById('bg-sunset');
const bgRain = document.getElementById('bg-rain');
const bgNight = document.getElementById('bg-night');
const bgMoon = document.getElementById('bg-moon');
const rainCanvas = document.getElementById('bg-rain-canvas');
const ctx = rainCanvas.getContext('2d');
const hint = document.getElementById('scroll-hint');
const hintText = hint?.querySelector('.typing-text');

const clamp = (v, lo, hi) => Math.max(lo, Math.min(hi, v));
const segT = (t, s, e) => clamp((t - s) / (e - s), 0, 1);
const ease = (t) => t < 0.5 ? 2 * t * t : -1 + (4 - 2 * t) * t;

const MAX_PROGRESS = 2.05;
const SENSITIVITY = 0.0003;

const SEGS = {
  dayToRain: [0.05, 0.25],
  rainToSunset: [0.30, 0.53],
  sunsetToNight: [0.55, 0.83],
  nightToMoon: [1.85, 2.05],
};

function getCurrentLang() {
  const urlLang = new URL(window.location.href).searchParams.get('lang');
  return urlLang || localStorage.getItem('lang') || 'es';
}

function buildTooltipSteps() {
  const lang = getCurrentLang();
  const t = translations[lang] || translations.es;

  return [
    { id: 'intro', at: 0, text: t.tooltipIntro },
    { id: 'special', at: 0.95, text: t.tooltipSpecial },
    { id: 'almost', at: 1.45, text: t.tooltipAlmost },
    { id: 'moon', at: 1.95, text: t.tooltipMoon },
  ];
}

let TOOLTIP_STEPS = buildTooltipSteps();

const resize = () => {
  rainCanvas.width = window.innerWidth;
  rainCanvas.height = window.innerHeight;
};
resize();
window.addEventListener('resize', resize);

const drops = Array.from({ length: 1000 }, () => ({
  x: Math.random() * window.innerWidth,
  y: Math.random() * window.innerHeight,
  speed: 9 + Math.random() * 10,
  len: 14 + Math.random() * 22,
  op: 0.2 + Math.random() * 0.5,
}));

let rainOp = 0;
let progress = 0;
let maxProgressReached = 0;
let lastTouchY = 0;
let activeTooltipStep = '__init__';
let hintTimer = 0;
let introDismissed = false;
let journeyCompleted = false; // 👈 cuando es true, scroll nativo libre y sin tooltips

function drawRain() {
  ctx.clearRect(0, 0, rainCanvas.width, rainCanvas.height);

  if (rainOp > 0.01) {
    for (const d of drops) {
      ctx.beginPath();
      ctx.moveTo(d.x, d.y);
      ctx.lineTo(d.x - 2, d.y + d.len);
      ctx.strokeStyle = `rgba(180, 210, 255, ${d.op * rainOp * 0.8})`;
      ctx.lineWidth = 1;
      ctx.stroke();

      d.y += d.speed;
      if (d.y > rainCanvas.height) {
        d.y = -d.len;
        d.x = Math.random() * rainCanvas.width;
      }
    }
  }

  requestAnimationFrame(drawRain);
}
drawRain();

const BORDER_COLORS = [
  [135, 206, 235, 0.25],
  [150, 160, 170, 0.25],
  [255, 160, 80, 0.35],
  [30, 30, 60, 0.15],
];

function getBorderColor(t) {
  const dayT = 1 - ease(segT(t, ...SEGS.dayToRain));
  const rainT = ease(segT(t, ...SEGS.dayToRain)) * (1 - ease(segT(t, ...SEGS.rainToSunset)));
  const sunsetT = ease(segT(t, ...SEGS.rainToSunset)) * (1 - ease(segT(t, ...SEGS.sunsetToNight)));
  const nightT = ease(segT(t, ...SEGS.sunsetToNight));

  return [0, 1, 2, 3].reduce((acc, i) => {
    const weight = [dayT, rainT, sunsetT, nightT][i];
    return [
      acc[0] + BORDER_COLORS[i][0] * weight,
      acc[1] + BORDER_COLORS[i][1] * weight,
      acc[2] + BORDER_COLORS[i][2] * weight,
      acc[3] + BORDER_COLORS[i][3] * weight,
    ];
  }, [0, 0, 0, 0]);
}

function updateBorderColor(t) {
  const [r, g, b, a] = getBorderColor(t);
  const value = `rgba(${Math.round(r)}, ${Math.round(g)}, ${Math.round(b)}, ${a.toFixed(2)})`;
  document.documentElement.style.setProperty('--win-border-color', value);
}

function updateTextColor(nightOp, moonOp) {
  const from = [34, 34, 34];
  const to = [255, 255, 255];
  const amount = Math.max(nightOp, moonOp);
  const r = from[0] + (to[0] - from[0]) * amount;
  const g = from[1] + (to[1] - from[1]) * amount;
  const b = from[2] + (to[2] - from[2]) * amount;

  document.documentElement.style.setProperty('--page-text-color', `rgb(${Math.round(r)}, ${Math.round(g)}, ${Math.round(b)})`);
  document.documentElement.style.setProperty('--tooltip-text-color', 'rgb(34, 34, 34)');
  
  // Invertir iconos a blanco en modo oscuro
  const iconInvert = amount; // 0 = negro, 1 = blanco
  document.documentElement.style.setProperty('--icon-filter', `invert(${iconInvert})`);
}

function getTypingDelay(char, speed = 22) {
  if (char === ' ') return speed * 0.45;
  if (/[,.!]/.test(char)) return speed * 2.2;
  return speed + Math.random() * 8;
}

function hideHint() {
  if (!hint) return;
  hint.classList.add('is-hidden');
  hint.classList.remove('is-visible');
}

function typeHint(text) {
  if (!hint || !hintText || !text) return;

  window.clearTimeout(hintTimer);
  hint.dataset.currentText = text;
  hint.classList.remove('is-hidden', 'is-typed');
  hint.classList.add('is-visible', 'is-typing');
  hintText.textContent = '';

  let index = 0;

  function typeNext() {
    if (index < text.length) {
      const char = text.charAt(index);
      hintText.textContent += char;
      index++;
      hintTimer = window.setTimeout(typeNext, getTypingDelay(char));
    } else {
      hint.classList.remove('is-typing');
      hint.classList.add('is-typed');
    }
  }

  typeNext();
}

function updateTooltip(t) {
  if (journeyCompleted) return; 
  if (!introDismissed) {
    if (t > 0.02) {
      hideHint();
      introDismissed = true;
    } else if (activeTooltipStep !== 'intro') {
      activeTooltipStep = 'intro';
      typeHint(TOOLTIP_STEPS[0].text);
    }
  }

  if (t <= maxProgressReached) return;
  maxProgressReached = t;

  const nextStep = [...TOOLTIP_STEPS].reverse().find((step) => step.id !== 'intro' && t >= step.at);
  if (!nextStep || nextStep.id === activeTooltipStep) return;

  activeTooltipStep = nextStep.id;
  typeHint(nextStep.text);

  if (nextStep.id === 'moon') {
    window.clearTimeout(window.__moonHideTimer);
    window.__moonHideTimer = window.setTimeout(() => {
      hideHint();
      journeyCompleted = true; 
    }, 6000);
  }
}

function updateLayers(t) {
  const rainOpNext = ease(segT(t, ...SEGS.dayToRain));
  const sunsetOp = ease(segT(t, ...SEGS.rainToSunset));
  const nightOp = ease(segT(t, ...SEGS.sunsetToNight));
  const moonOp = ease(segT(t, ...SEGS.nightToMoon));

  bgRain.style.opacity = String(rainOpNext);
  bgSunset.style.opacity = String(sunsetOp);
  bgNight.style.opacity = String(nightOp);
  bgMoon.style.opacity = String(moonOp);

  rainOp = rainOpNext * (1 - sunsetOp);
  rainCanvas.style.opacity = rainOp > 0.01 ? '1' : '0';

  updateBorderColor(t);
  updateTextColor(nightOp, moonOp);
  updateTooltip(t);
}

function advanceProgress(delta) {
  progress = clamp(progress + delta, 0, MAX_PROGRESS);
  updateLayers(progress);
}
const FAST_SENSITIVITY = 0.0015;

function onWheel(e) {
  const s = journeyCompleted ? FAST_SENSITIVITY : SENSITIVITY;
  advanceProgress(e.deltaY * s);
}

function onTouchMove(e) {
  const delta = lastTouchY - e.touches[0].clientY;
  lastTouchY = e.touches[0].clientY;
  const s = journeyCompleted ? FAST_SENSITIVITY : SENSITIVITY;
  advanceProgress(delta * s * 3);
}

window.addEventListener('wheel', onWheel, { passive: true });
window.addEventListener('touchstart', (e) => {
  lastTouchY = e.touches[0].clientY;
}, { passive: true });
window.addEventListener('touchmove', onTouchMove, { passive: true });

window.addEventListener('langchange', () => {
  TOOLTIP_STEPS = buildTooltipSteps();
  const current = TOOLTIP_STEPS.find(s => s.id === activeTooltipStep);
  if (current && !journeyCompleted) typeHint(current.text);
});

updateLayers(0);

});
</script>