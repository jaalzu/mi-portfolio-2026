---
import Projects from '../components/sections/Projects.astro';
import AboutMe from '../components/sections/AboutMe.astro';
import Picture from '../components/sections/Picture.astro';
import Contact from '../components/sections/Contact.astro';
import TechStack from '../components/sections/TechStack.astro';
import '../styles/global.css'
import { Image } from 'astro:assets';
import bgImage from '../assets/windows_vista_90.webp';
---



<html lang="es">
  <head>
    <meta charset="utf-8" />
 <link rel="preload" href="/fonts/Inter-Bold.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="/fonts/Inter-Regular.woff2" as="font" type="font/woff2" crossorigin>
    <meta name="viewport" content="width=device-width" />
    <title>Javier Alzú Portfolio</title>
  </head>

  <body>
   <div class="bg-container">
    <Image 
      src={bgImage} 
      alt="Fondo Windows Vista" 
      quality="80" 
      loading="eager"
      fetchpriority="high"
    />
  </div>

    <main class="parent">    
      <div class="projects"><Projects /></div>
      <div class="about-me"><AboutMe /></div>
      <div class="right-column">
        <div class="picture"><Picture /></div>
        <div class="contact"><Contact /></div>
      </div>
      <div class="tech-stack"><TechStack /></div>
    </main>
  </body>
</html>

<style>
  body {
    margin: 0;
    padding: 0 40px;
    box-sizing: border-box;
    min-height: 100vh;
    font-family: 'Inter', monospace;
    color: var(--color-white-pure);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  
  .right-column{
    display: contents;
  }

  .bg-container {
    position: fixed;
    inset: 0;
    z-index: -1;
    pointer-events: none; 
  }
  .bg-container img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* ============================================
     DESKTOP (>1024px) - Layout original
     ============================================ */
  .parent {
    display: grid;
    grid-template-columns: 2.2fr 0.9fr 0.7fr 1fr; 
    grid-template-rows: repeat(4, 1fr);
    grid-column-gap: 20px;
    grid-row-gap: 20px;
    width: 100%;
    height: 90vh;
  }

  .projects { grid-area: 1 / 3 / 5 / 5; }
  .about-me { grid-area: 1 / 1 / 3 / 2; }
  .picture { grid-area: 1 / 2 / 3 / 3; }
  .contact { grid-area: 3 / 2 / 5 / 3; }
  .tech-stack { grid-area: 3 / 1 / 5 / 1; }

  .projects, .about-me, .picture, .contact, .tech-stack {
    display: flex;
  }

  .projects :global(.glass-card),
  .about-me :global(.glass-card),
  .picture :global(.glass-card),
  .contact :global(.glass-card),
  .tech-stack :global(.glass-card) {
    width: 100%;
    height: 100%;
  }



/* ============================================
    DESKTOP MEDIANO (1025px - 1522px)
   ============================================ */
@media (max-width: 1522px) {
  .parent {
    grid-template-columns: 1.2fr 0.8fr; 
    grid-template-rows: auto auto auto;
    height: auto;
    margin-block: 1rem;
    gap: 20px;
  }

  .about-me { 
    grid-area: 1 / 1 / 2 / 3; 
  }

  .projects { 
    grid-area: 2 / 1 / 3 / 2; 
  }

  .tech-stack { 
    grid-area: 2 / 2 / 3 / 3; 
  }


  .right-column {
    grid-area: 3 / 1 / 4 / 3;
    display: grid;
    grid-template-columns: 0.6fr 1.4fr; 
    gap: 20px;
  }

  .picture {
    grid-area: auto;
    width: 100%;
    max-height: auto; 
  }
  
  .contact {
    grid-area: auto;
    width: 100%;
  }
}

  

  
 
 /* ============================================
      TABLET (768px - 1024px)
     ============================================ */
  @media (max-width: 1024px) {
    body {
      padding: 20px;
    }

    .parent {
      display: grid;
      grid-template-columns: 1.2fr 1fr; 
      grid-template-rows: auto; 
      align-items: start; 
      height: auto;
      gap: 15px;
      width: 100%;
    }

    .about-me { grid-area: 1 / 1 / 2 / 3; }
  .projects { grid-area: 2 / 1 / 3 / 2; }
  
  .right-column {
    display: flex;       
    flex-direction: column; 
    gap: 15px;          
    grid-area: 2 / 2 / 3 / 3; */
  }

  .picture, .contact { grid-area: auto; }

  .tech-stack { grid-area: 3 / 1 / 4 / 3; }
  }



  
/* ============================================
      MOBILE (hasta 768px)
     ============================================ */
  @media (max-width: 768px) {
    body {
      padding: 10px;
      display: block; 
    }

    .parent {
      display: grid;
      grid-template-columns: 100%; 
      grid-template-rows: auto;
      gap: 20px; 
      height: auto;
      width: 100%;
      margin: 0 auto;
      padding: 0;
    }

    .right-column {
      display: contents; 
    }

    .about-me, .projects, .picture, .tech-stack, .contact {
      width: 100% !important;
      max-width: 100% !important;
      grid-area: auto !important; 
      margin: 0;
      box-sizing: border-box;
    }

    .about-me { order: 1; }
    .projects { order: 2; min-height: 400px; }
    .picture  { order: 3; height: 250px; }
    .tech-stack { order: 4; }
    .contact  { order: 5; }
  }

 /* ============================================
      MOBILE PEQUEÑO (hasta 480px)
     ============================================ */
  @media (max-width: 480px) {
    body {
      padding: 10px; 
      margin: 0;
    }

    .parent {
      gap: 25px; 
      display: flex;
      flex-direction: column;
    }

    .projects {
   
      height: auto !important;
      min-height: 500px; 
      width: 100% !important;
    }

    .picture {
      height: 200px !important;
      max-height: none;
    }

    * {
      max-width: 100vw;
      box-sizing: border-box;
    }
  }
</style>