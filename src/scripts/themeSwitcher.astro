<script is:inline>
  function initTabs() {
    document.querySelectorAll('[role="tablist"]').forEach(tablist => {
      const tabs = tablist.querySelectorAll('[role="tab"]');
      const panels = tablist.closest('.tabs')?.querySelectorAll('[role="tabpanel"]') ?? [];

      tabs.forEach((tab, i) => {
        const newTab = tab.cloneNode(true);
        tab.parentNode.replaceChild(newTab, tab);

        newTab.addEventListener('click', () => {
          tabs.forEach((t, j) => {
            // Buscamos el tab original en el DOM actualizado
            const allTabs = tablist.querySelectorAll('[role="tab"]');
            allTabs[j].setAttribute('aria-selected', 'false');
            if (panels[j]) panels[j].setAttribute('hidden', '');
          });
          newTab.setAttribute('aria-selected', 'true');
          if (panels[i]) panels[i].removeAttribute('hidden');
        });
      });
    });
  }

  function applyTheme(theme) {
    // --- LÓGICA DE RESET ---
    document.querySelectorAll('details').forEach(d => d.removeAttribute('open'));

    document.querySelectorAll('.tabs').forEach(container => {
      const tabs = container.querySelectorAll('[role="tab"]');
      const panels = container.querySelectorAll('[role="tabpanel"]');
      
      tabs.forEach((t, i) => {
        t.setAttribute('aria-selected', i === 0 ? 'true' : 'false');
      });
      panels.forEach((p, i) => {
        if (i === 0) p.removeAttribute('hidden');
        else p.setAttribute('hidden', '');
      });
    });
    // --- FIN RESET ---

    document.documentElement.setAttribute('data-theme', theme);
    document.querySelector('.desktop').classList.toggle('win7', theme === 'win7');
    localStorage.setItem('retro-theme', theme);

    // re-init tabs al cambiar tema para asegurar que los eventos respondan al nuevo layout
    initTabs();

    document.querySelectorAll('#theme-switchers a').forEach(b => {
      const target = b.getAttribute('data-theme-target');
      const isActive = target === theme;
      b.style.opacity = isActive ? '0.5' : '1';
      b.style.pointerEvents = isActive ? 'none' : '';
    });
  }

  const saved = localStorage.getItem('retro-theme') ?? 'xp';
  applyTheme(saved);

  document.querySelectorAll('#theme-switchers a').forEach(btn => {
    btn.addEventListener('click', (e) => {
      e.preventDefault();
      applyTheme(btn.getAttribute('data-theme-target'));
    });
  }); 
</script>