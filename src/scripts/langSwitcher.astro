---
import { translations } from '../lib/translations';
---

<script is:inline define:vars={{ translations }}>
  let currentLang = 'es';

  function applyLang(lang, updateUrl = true) {
    currentLang = lang;
    const t = translations[lang] || translations.es;
    window.__translations = translations;

    document.querySelectorAll('[data-i18n]').forEach(el => {
      const key = el.getAttribute('data-i18n');
      if (t[key]) el.textContent = t[key];
    });

    document.documentElement.setAttribute('lang', lang);
    localStorage.setItem('lang', lang);

    if (updateUrl) {
      const url = new URL(window.location.href);
      url.searchParams.set('lang', lang);
      window.history.replaceState({}, '', url);
    }

    const switcherBtn = document.getElementById('lang-switcher');
    if (switcherBtn) switcherBtn.textContent = lang === 'es' ? 'EN' : 'ES';

    window.dispatchEvent(new CustomEvent('langchange', { detail: { lang } }));
  }

  document.addEventListener('DOMContentLoaded', () => {
    const urlLang = new URL(window.location.href).searchParams.get('lang');
    const saved = urlLang || localStorage.getItem('lang') || 'es';
    applyLang(saved, false);

    document.getElementById('lang-switcher')?.addEventListener('click', () => {
      applyLang(currentLang === 'es' ? 'en' : 'es');
    });
  });
</script>