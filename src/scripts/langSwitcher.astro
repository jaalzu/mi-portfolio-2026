---
import { translations } from '../lib/translations';
---



<script is:inline define:vars={{ translations }}>
  let currentLang = 'es';

  function applyLang(lang, updateUrl = true) {
    currentLang = lang;
    const t = translations[lang] || translations.es;
    window.__translations = translations;

    document.querySelectorAll('[data-i18n]').forEach(el => {
      const key = el.getAttribute('data-i18n');
      if (t[key]) el.innerHTML = t[key];
    });

    // Imagen simple sin carousel (data-i18n-img-es / -en directo en el <img>)
    document.querySelectorAll('[data-i18n-img-es]:not(.project-img)').forEach(el => {
      const src = el.getAttribute(`data-i18n-img-${lang}`);
      if (src) el.src = src;
    });

    // Imagen de portada dentro de un carousel (.project-img con data-images)
    document.querySelectorAll('.project-img[data-i18n-img-en]').forEach(img => {
      const esSrc = img.getAttribute('data-i18n-img-es');
      const enSrc = img.getAttribute('data-i18n-img-en');
      const newFirst = lang === 'en' ? enSrc : esSrc;

      const list = img.getAttribute('data-images')?.split(',').filter(Boolean) ?? [];
      if (list.length > 0) {
        list[0] = newFirst;
        img.setAttribute('data-images', list.join(','));
      }

      const dotsContainer = img.closest('.tabs')?.querySelector('.img-dots');
      const activeDot = dotsContainer?.querySelector('.img-dot.is-active');
      const activeIndex = activeDot
        ? Array.from(dotsContainer.querySelectorAll('.img-dot')).indexOf(activeDot)
        : 0;

      if (activeIndex === 0) {
        img.src = newFirst;
      }
    });

    document.documentElement.setAttribute('lang', lang);
    localStorage.setItem('lang', lang);

    if (updateUrl) {
      const url = new URL(window.location.href);
      url.searchParams.set('lang', lang);
      window.history.replaceState({}, '', url);
    }

    const switcherBtn = document.getElementById('lang-switcher');
    if (switcherBtn) {
      switcherBtn.textContent = lang === 'es' ? 'ENG' : 'ESP';
    }

    window.dispatchEvent(new CustomEvent('langchange', { detail: { lang } }));
  }

  document.addEventListener('DOMContentLoaded', () => {
    const urlLang = new URL(window.location.href).searchParams.get('lang');
    const saved = urlLang || localStorage.getItem('lang') || 'es';

    applyLang(saved, false);

    document.getElementById('lang-switcher')?.addEventListener('click', () => {
      applyLang(currentLang === 'es' ? 'en' : 'es');
    });
  });
</script>

