---
import { translations } from '../lib/translations';
---

<script is:inline define:vars={{ translations }}>
  function applyLang(lang, updateUrl = true) {
  currentLang = lang;
  const t = translations[lang];
  document.querySelectorAll('[data-i18n]').forEach(el => {
    const key = el.getAttribute('data-i18n');
    if (t[key]) el.textContent = t[key];
  });
  document.documentElement.setAttribute('lang', lang);
  localStorage.setItem('lang', lang);
  
  if (updateUrl) {
    const url = new URL(window.location.href);
    url.searchParams.set('lang', lang);
    window.history.replaceState({}, '', url);
  }

  document.getElementById('lang-switcher').textContent = lang === 'es' ? 'EN' : 'ES';


  document.querySelectorAll('[data-tech-container]').forEach(container => {
    const card = container.closest('.project-card');
    const techKeysStr = card?.getAttribute('data-tech-keys');
    if (!techKeysStr) return;
    
    const techKeys = JSON.parse(techKeysStr);
    const ul = container.querySelector('ul');
    if (!ul) return;
    
    ul.innerHTML = '';
    Object.entries(techKeys).forEach(([category, key]) => {
      const items = t[key] || [];
      const li = document.createElement('li');
      li.innerHTML = `
        <details>
          <summary>${category}</summary>
          <ul>
            ${Array.isArray(items) 
              ? items.map(item => `<li>${item}</li>`).join('')
              : `<li>${items}</li>`
            }
          </ul>
        </details>
      `;
      ul.appendChild(li);
    });
  });
}

document.addEventListener('DOMContentLoaded', () => {
  const urlLang = new URL(window.location.href).searchParams.get('lang');
  const saved = urlLang || localStorage.getItem('lang') || 'es';
  applyLang(saved, false);

  document.getElementById('lang-switcher')?.addEventListener('click', () => {
    applyLang(currentLang === 'es' ? 'en' : 'es');
  });
});
</script>